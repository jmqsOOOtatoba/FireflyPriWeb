---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import BackToComment from "./BackToComment.astro";
import BackToHome from "./BackToHome.astro";
import BackToTop from "./BackToTop.astro";
import FloatingTOC from "./FloatingTOC.astro";
import ImmersiveReading from "./ImmersiveReading.astro";
import ImmersiveTOC from "./ImmersiveTOC.astro";

interface Props {
	headings?: MarkdownHeading[];
	encrypted?: boolean;
}

const { headings, encrypted } = Astro.props;
const immersiveReadingEnabled =
	siteConfig.post.immersiveReading?.enable !== false;
const readingProgressEnabled = siteConfig.post.readingProgress;
---

<div class="floating-controls-container">
  {readingProgressEnabled && (
    <div id="reading-progress-badge" class="reading-progress-badge">
      <span id="reading-progress-pct">0%</span>
      <span
        id="reading-progress-remain"
        data-template={i18n(I18nKey.timeRemaining)}
      ></span>
    </div>
  )}
  <FloatingTOC headings={headings ?? []} encrypted={encrypted} />
  {immersiveReadingEnabled && (
    <>
      <ImmersiveReading />
      <ImmersiveTOC headings={headings ?? []} encrypted={encrypted} />
    </>
  )}
  <BackToComment />
  <BackToHome />
  <BackToTop />
</div>

<style>
  /* 阅读进度徽章：右下角悬浮栈的首项，非文章页/未激活时完全隐藏 */
  #reading-progress-badge {
    display: none;
    align-items: center;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--primary);
    background-color: var(--card-bg);
    border: 1px solid rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
    user-select: none;
    /* 文字更新的布局失效限制在徽章子树内，不污染正文布局 */
    contain: content;
  }

  #reading-progress-badge.show {
    display: flex;
  }

  /* 切页期间隐藏，visit:end 移除类并刷新后重新显示，避免旧页百分比残值闪现 */
  :global(html.is-page-transitioning) #reading-progress-badge {
    display: none;
  }

  #reading-progress-remain {
    color: rgba(0, 0, 0, 0.45);
  }

  :global(.dark) #reading-progress-badge {
    background-color: var(--card-bg);
    border-color: rgba(255, 255, 255, 0.15);
  }

  :global(.dark) #reading-progress-remain {
    color: rgba(255, 255, 255, 0.45);
  }

  .floating-controls-container {
    position: fixed;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end; /* 右对齐 */
    pointer-events: none; /* 容器不阻挡点击 */
    
    /* 默认桌面端位置 - 对应 BackToTop 的位置 */
    right: 1rem;
    bottom: 4rem;
  }

  /* 响应式调整 - 保持原有的位置逻辑 */
  @media (max-width: 1024px) {
    .floating-controls-container {
      right: 1rem;
      bottom: 4rem;
    }
  }

  @media (max-width: 768px) {
    .floating-controls-container {
      right: 0.75rem;
      bottom: 4rem;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .floating-controls-container {
      right: 0.5rem;
      bottom: 4rem;
    }
  }

  /* 高缩放比例适配 */
  @media (min-resolution: 2dppx) {
    .floating-controls-container {
      right: max(0.5rem, 2rem - 2vw);
      bottom: max(3rem, 4rem - 5vh);
    }
  }
  
  /* 横屏模式适配 */
  @media (orientation: landscape) and (max-height: 500px) {
    .floating-controls-container {
      bottom: 4rem; 
    }
  }

  /* 极低分辨率适配 */
  @media (max-width: 320px) {
    .floating-controls-container {
        right: 0.125rem;
        bottom: 4rem;
    }
  }
</style>