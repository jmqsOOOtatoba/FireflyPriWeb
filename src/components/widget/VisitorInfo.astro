---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
---

<WidgetLayout
  name="访客信息"
  showTitle={showTitle}
  id="visitor-info"
  class:list={[className, "visitor-info-widget"]}
  style={style}
>
  <div class="visitor-info-content flex flex-col gap-3">
    <div class="text-center text-neutral-500 dark:text-neutral-400 text-sm">
      加载中...
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  function weatherEmoji(iconCode) {
    var c = parseInt(iconCode, 10);
    if (isNaN(c)) return '🌈';
    if (c === 100 || c === 150) return '☀️';
    if (c === 101 || c === 151) return '🌤️';
    if (c === 102 || c === 152) return '🌥️';
    if (c === 103 || c === 104 || c === 153) return '☁️';
    if (c >= 300 && c < 400) return '🌧️';
    if (c >= 400 && c < 500) return '❄️';
    if (c >= 500 && c < 515) return '🌫️';
    return '🌈';
  }

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text == null ? '' : String(text);
    return div.innerHTML;
  }

  function statCard(emoji, label, value) {
    return '<div class="rounded-xl bg-neutral-100/60 dark:bg-neutral-800/50 px-3 py-2.5 flex flex-col gap-1">' +
      '<span class="text-xs text-neutral-500 dark:text-neutral-400">' + emoji + ' ' + label + '</span>' +
      '<span class="text-sm font-bold text-neutral-900 dark:text-neutral-100 truncate">' + escapeHtml(value) + '</span>' +
    '</div>';
  }

  var ALERT_TAB_BASE = 'weather-alert-tab text-xs px-2.5 py-1 rounded-full cursor-pointer transition-colors whitespace-nowrap';
  var ALERT_TAB_ACTIVE = 'bg-(--primary) text-white';
  var ALERT_TAB_IDLE = 'bg-neutral-100/70 dark:bg-neutral-800/70 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200/80 dark:hover:bg-neutral-700/70';

  function alertTabLabel(alert) {
    return alert.title || [alert.type, alert.level].filter(Boolean).join('') || '预警';
  }

  function buildGuidanceHtml(guidance) {
    if (!Array.isArray(guidance)) return '';
    var listItems = [];
    var tagItems = [];
    guidance.forEach(function(item) {
      var s = item == null ? '' : String(item).trim();
      if (!s) return;
      // 带编号的长句作为列表条目，短词作为标签
      if (/^\d+[、.．]/.test(s) || s.length > 10) listItems.push(s);
      else tagItems.push(s);
    });
    if (!listItems.length && !tagItems.length) return '';
    var html = '<div class="weather-alert-guide mt-1 pt-2 border-t border-neutral-200/70 dark:border-neutral-700/50">' +
      '<div class="text-xs font-medium text-neutral-600 dark:text-neutral-300 mb-1.5">🛡️ 防御指南</div>';
    if (listItems.length) {
      html += '<div class="flex flex-col gap-1 text-xs text-neutral-500 dark:text-neutral-400">';
      listItems.forEach(function(s) {
        html += '<div>' + escapeHtml(s) + '</div>';
      });
      html += '</div>';
    }
    if (tagItems.length) {
      html += '<div class="flex flex-wrap gap-1.5 mt-1.5">';
      tagItems.forEach(function(s) {
        html += '<span class="rounded-full bg-neutral-100/80 dark:bg-neutral-800/80 px-2 py-0.5 text-[11px] text-neutral-600 dark:text-neutral-300">' + escapeHtml(s) + '</span>';
      });
      html += '</div>';
    }
    html += '</div>';
    return html;
  }

  function buildAlertBody(alert, index, single) {
    var html = '<div class="weather-alert-body flex flex-col gap-1.5" data-index="' + index + '">';
    var title = alert.title == null ? '' : String(alert.title).trim();
    if (single && title) {
      html += '<span class="text-xs font-medium text-(--primary)">📢 ' + escapeHtml(title) + '</span>';
    }
    var text = alert.text == null ? '' : String(alert.text).trim();
    if (text) {
      html += '<div class="weather-alert-text text-xs text-neutral-500 dark:text-neutral-400 whitespace-pre-wrap break-words line-clamp-2">' + escapeHtml(text) + '</div>';
    }
    html += buildGuidanceHtml(alert.guidance);
    html += '<button type="button" class="weather-alert-toggle hidden self-start text-xs font-medium text-(--primary) hover:underline cursor-pointer">展开</button>';
    html += '</div>';
    return html;
  }

  function setupAlertBody(body) {
    var textEl = body.querySelector('.weather-alert-text');
    var guideEl = body.querySelector('.weather-alert-guide');
    var btn = body.querySelector('.weather-alert-toggle');
    if (!btn) return;

    // 文字被截断（超出两行）或有防御指南时才需要展开按钮
    var textClamped = false;
    if (textEl) {
      var clampedHeight = textEl.clientHeight;
      textEl.classList.remove('line-clamp-2');
      var fullHeight = Math.max(textEl.scrollHeight, textEl.clientHeight);
      textEl.classList.add('line-clamp-2');
      textClamped = fullHeight > clampedHeight + 1;
    }
    if (!textClamped && !guideEl) return;

    if (guideEl) guideEl.classList.add('hidden');
    btn.classList.remove('hidden');
    btn.addEventListener('click', function() {
      var expanded = body.classList.toggle('is-expanded');
      if (textEl) textEl.classList.toggle('line-clamp-2', !expanded);
      if (guideEl) guideEl.classList.toggle('hidden', !expanded);
      btn.textContent = expanded ? '收起' : '展开';
    });
  }

  function setupAlertTabs(container) {
    var tabs = container.querySelectorAll('.weather-alert-tab');
    if (!tabs.length) return;
    var bodies = container.querySelectorAll('.weather-alert-body');
    function activate(activeIndex) {
      tabs.forEach(function(tab, i) {
        tab.className = ALERT_TAB_BASE + (i === activeIndex ? ' ' + ALERT_TAB_ACTIVE : ' ' + ALERT_TAB_IDLE);
        tab.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false');
      });
      bodies.forEach(function(body, i) {
        body.classList.toggle('hidden', i !== activeIndex);
      });
    }
    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() { activate(i); });
    });
    activate(0);
  }

  async function loadVisitorInfo() {
    var containers = document.querySelectorAll('.visitor-info-content');

    containers.forEach(function(container) {
      if (container.getAttribute('data-loaded') === 'true') return;
      fetchWeatherData(container);
    });
  }

  async function fetchWeatherData(container) {
    try {
      var response = await fetch('https://uapis.cn/api/v1/misc/weather');
      var data = await response.json();

      var emoji = weatherEmoji(data.weather_icon);
      var weatherText = data.weather || '未知';
      var locationText = [data.city, data.district].filter(Boolean).join(' · ') || '未知位置';
      var tempText = data.temperature != null ? data.temperature + '°' : '--';
      var windText = (data.wind_direction || '') + (data.wind_power || '');
      var alertsHtml = '';
      var alerts = Array.isArray(data.alerts) ? data.alerts.filter(function(a) { return a && typeof a === 'object'; }) : [];
      if (alerts.length > 0) {
        var single = alerts.length === 1;
        var tabsHtml = '';
        if (!single) {
          tabsHtml = '<div class="weather-alert-tabs flex flex-wrap gap-1.5" role="tablist">';
          alerts.forEach(function(a, i) {
            tabsHtml += '<button type="button" role="tab" aria-selected="false" data-index="' + i + '" ' +
              'class="' + ALERT_TAB_BASE + ' ' + ALERT_TAB_IDLE + '">' + escapeHtml(alertTabLabel(a)) + '</button>';
          });
          tabsHtml += '</div>';
        }
        var bodiesHtml = alerts.map(function(a, i) { return buildAlertBody(a, i, single); }).join('');
        alertsHtml = '<div class="rounded-xl bg-neutral-100/60 dark:bg-neutral-800/50 px-3 py-2.5 flex flex-col gap-2">' +
          tabsHtml + bodiesHtml +
        '</div>';
      }

      container.innerHTML = '<div class="flex flex-col gap-3">' +
        '<div class="flex items-center gap-3 px-1">' +
          '<div class="text-4xl leading-none shrink-0">' + emoji + '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<div class="flex items-baseline gap-2 flex-wrap">' +
              '<span class="text-3xl font-bold leading-none text-neutral-900 dark:text-neutral-100">' + escapeHtml(tempText) + '</span>' +
              '<span class="text-sm font-medium text-neutral-600 dark:text-neutral-300">' + escapeHtml(weatherText) + '</span>' +
            '</div>' +
            '<div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400 truncate">📍 ' + escapeHtml(locationText) + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="grid grid-cols-2 gap-2">' +
          statCard('💨', '风力', windText || '未知') +
          statCard('💧', '湿度', data.humidity != null ? data.humidity + '%' : '未知') +
        '</div>' +
        alertsHtml +
        '<div class="text-center text-xs text-neutral-400 dark:text-neutral-500">' +
          escapeHtml(data.report_time || '') +
        '</div>' +
      '</div>';

      container.setAttribute('data-loaded', 'true');
      // 先在全部 body 可见时测量文字高度，再用 tabs 隐藏非活动项
      container.querySelectorAll('.weather-alert-body').forEach(function(body) {
        setupAlertBody(body);
      });
      setupAlertTabs(container);

    } catch (error) {
      console.error('获取访客信息失败:', error);
      container.innerHTML = '<div class="text-center text-red-500 text-sm py-2">加载失败</div>';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadVisitorInfo);
  } else {
    loadVisitorInfo();
  }

  document.addEventListener('swup:contentReplaced', loadVisitorInfo);
</script>
