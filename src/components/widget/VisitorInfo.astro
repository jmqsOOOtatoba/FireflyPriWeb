---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
  class?: string;
  style?: string;
  widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
---

<WidgetLayout
  name="访客信息"
  showTitle={showTitle}
  id="visitor-info"
  class:list={[className, "visitor-info-widget"]}
  style={style}
>
  <div class="visitor-info-content flex flex-col gap-3">
    <div class="text-center text-neutral-500 dark:text-neutral-400 text-sm">
      加载中...
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  async function loadVisitorInfo() {
    var containers = document.querySelectorAll('.visitor-info-content');
    
    containers.forEach(function(container) {
      if (container.getAttribute('data-loaded') === 'true') return;
      fetchWeatherData(container);
    });
  }

  async function fetchWeatherData(container) {
    try {
      var response = await fetch('https://uapis.cn/api/v1/misc/weather');
      var data = await response.json();
      var locationText = data.city + ', ' + data.district;

      var weatherText = data.weather || '未知';
      container.innerHTML = '<div class="flex flex-col gap-2">' +
        '<div class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-100/60 dark:bg-neutral-800/50">' +
          '<div class="flex items-center gap-2.5">' +
            '<div class="text-(--primary) text-lg">' +
              '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>' +
            '</div>' +
            '<span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">位置</span>' +
          '</div>' +
          '<span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">' + locationText + '</span>' +
        '</div>' +
        '<div class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-100/60 dark:bg-neutral-800/50">' +
          '<div class="flex items-center gap-2.5">' +
            '<div class="text-(--primary) text-lg">' +
              '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zm-3.21 13.7l1.79 1.8 1.41-1.41-1.8-1.79-1.4 1.4zM20 10.5v2h3v-2h-3zm-8-5c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm-1 16.95h2V19.5h-2v2.95zm-7.45-3.91l1.41 1.41 1.79-1.8-1.41-1.41-1.79 1.8z"/></svg>' +
            '</div>' +
            '<span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">天气</span>' +
          '</div>' +
          '<span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">' + weatherText + '</span>' +
        '</div>' +
        '<div class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-100/60 dark:bg-neutral-800/50">' +
          '<div class="flex items-center gap-2.5">' +
            '<div class="text-(--primary) text-lg">' +
              '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M15 13V5c0-1.66-1.34-3-3-3S9 3.34 9 5v8c-1.21.91-2 2.37-2 4 0 2.76 2.24 5 5 5s5-2.24 5-5c0-1.63-.79-3.09-2-4zm-4-8c0-.55.45-1 1-1s1 .45 1 1h-1v1h1v2h-1v1h1v2h-2V5z"/></svg>' +
            '</div>' +
            '<span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">温度</span>' +
          '</div>' +
          '<span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">' + data.temperature + '°C ' + data.wind_direction + data.wind_power + '</span>' +
        '</div>' +
      '</div>';
      
      container.setAttribute('data-loaded', 'true');

    } catch (error) {
      console.error('获取访客信息失败:', error);
      container.innerHTML = '<div class="text-center text-red-500 text-sm py-2">加载失败</div>';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadVisitorInfo);
  } else {
    loadVisitorInfo();
  }

  document.addEventListener('swup:contentReplaced', loadVisitorInfo);
</script>
