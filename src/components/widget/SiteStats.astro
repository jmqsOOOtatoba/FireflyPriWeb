---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { analyticsConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];

		totalWords += chineseChars.length + englishChars.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 获取「最后活动」时间：取每篇文章 published 与 updated 中较新的那个，再从全站所有文章里取最大值。这样新发文章和修改老文章都会刷新该字段。
const getActivityDate = (post: (typeof posts)[number]): Date => {
	const { published, updated } = post.data;
	if (updated && updated > published) return updated;
	return published;
};

const lastActivityDate = posts.reduce<Date | null>((latest, post) => {
	const current = getActivityDate(post);
	if (!latest || current > latest) return current;
	return latest;
}, null);

const lastPostDate = lastActivityDate ? lastActivityDate.toISOString() : null;

const todayText = i18n(I18nKey.today);

// Umami 公开分享链接：SiteStats 经 /api/share/<slug> 只读拉取总浏览量/访客数
const umamiShareUrl = analyticsConfig.umamiAnalytics?.shareUrl || "";

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "mingcute:heartbeat-line",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-(--primary) text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
            data-stat-value
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}


<!-- Umami 统计：总浏览量 -->
<div class="flex items-center justify-between px-3 py-1.5">
    <div class="flex items-center gap-2.5">
        <div class="text-(--primary) text-xl">
            <Icon is:inline name="material-symbols:visibility-outline" />
        </div>
        <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            总浏览量
        </span>
    </div>
    <div class="flex items-center">
        <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                        <span data-umami-key="pageviews">-</span>
        </span>
    </div>
</div>

<!-- Umami 统计：访客数 -->
<div class="flex items-center justify-between px-3 py-1.5">
    <div class="flex items-center gap-2.5">
        <div class="text-(--primary) text-xl">
            <Icon name="material-symbols:group" />
        </div>
        <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            访客数
        </span>
    </div>
    <div class="flex items-center">
        <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                       <span data-umami-key="visitors">-</span>
        </span>
    </div>
</div>







  </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastPostDate, todayText, umamiShareUrl }}>
  function updateDynamicStats() {
    const today = new Date();

    // 更新运行天数
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    const runningDaysElements = document.querySelectorAll('[data-stat-id="running-days"]');
    runningDaysElements.forEach((element) => {
      element.textContent = diffDays.toString();
    });

    // 更新最后活动时间
    if (lastPostDate) {
      const lastPost = new Date(lastPostDate);
      const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
      const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));

      const lastUpdateElements = document.querySelectorAll('[data-stat-id="last-update"]');
      lastUpdateElements.forEach((element) => {
        if (daysSinceLastUpdate === 0) {
          element.textContent = todayText;
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = 'none';
          }
        } else {
          element.textContent = daysSinceLastUpdate.toString();
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = '';
          }
        }
      });
    }
  }

  // 通过 Umami 公开分享接口拉取站点统计（只读，无需管理员 token）：
  //   GET <origin>/api/share/<slug>            -> { websiteId, token }
  //   GET <origin>/api/websites/<id>/stats     -> 需 x-umami-share-token 头
  // 拉取失败就停留在占位符 "-"，不做隐藏（2026-10-21 用户指定）。
  // 云端历史累计（Umami Cloud，2026-08-14 ~ 2026-10-21 迁移至自建前的精确值，
  // 展示层 = 自建新计数 + 此偏移，实现数字无缝续接；换统计方案时改这里）
  const UMAMI_HISTORY = { pageviews: 5605, visitors: 774 };

  function setUmamiValue(key, value) {
    const total = (Number(value) || 0) + (UMAMI_HISTORY[key] || 0);
    const text = total.toLocaleString();
    document.querySelectorAll(`[data-umami-key="${key}"]`).forEach((element) => {
      element.textContent = text;
    });
  }

  function umamiValuesFilled() {
    const el = document.querySelector('[data-umami-key="pageviews"]');
    return !!el && /^\d/.test(el.textContent.trim());
  }

  async function fetchUmamiStats() {
    if (!umamiShareUrl) return;
    const slug = umamiShareUrl.split("/share/")[1];
    if (!slug) return;
    const apiBase = new URL(umamiShareUrl).origin + "/api";
    try {
      const shareRes = await fetch(`${apiBase}/share/${encodeURIComponent(slug)}`);
      if (!shareRes.ok) throw new Error(`share ${shareRes.status}`);
      const share = await shareRes.json();
      const endAt = Date.now();
      const statsRes = await fetch(
        `${apiBase}/websites/${share.websiteId}/stats?startAt=0&endAt=${endAt}`,
        {
          headers: {
            "x-umami-share-token": share.token,
            "x-umami-share-context": "1",
          },
        },
      );
      if (!statsRes.ok) throw new Error(`stats ${statsRes.status}`);
      const stats = await statsRes.json();
      setUmamiValue("pageviews", stats.pageviews?.value ?? 0);
      setUmamiValue("visitors", stats.visitors?.value ?? 0);
    } catch (error) {
      console.error("[SiteStats] Umami 拉取失败:", error);
    }
  }

  // 页面加载时更新
  updateDynamicStats();

  // 页面切换时重新更新
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(() => {
      updateDynamicStats();
    }, 100);
  });

  // 防止 Swup 切页重跑脚本时重复注册监听器
  if (!window.__siteStatsInit) {
    window.__siteStatsInit = true;
    // 页面切换时重新更新
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(updateDynamicStats, 100);
    });

    fetchUmamiStats();
    // 网络抖动兜底：4 秒后仍无数据就再试一次
    setTimeout(() => {
      if (!umamiValuesFilled()) fetchUmamiStats();
    }, 4000);
  }
</script>

<script>
import { animate } from "animejs";

// 数字滚动（anime.js）：每会话首次出现统计面板时，可见后把各数值从 0 滚到终值。
// 上方 define:vars 脚本是 classic script（解析期执行），本模块脚本 defer 执行——
// 运行时动态值（运行天数/最后更新）已被写好，textContent 即终值。
const COUNTED_KEY = "ff-site-stats-counted";

function isCountable(text: string): boolean {
	return /^\d+$/.test(text) || /^\d{1,3}(,\d{3})+$/.test(text);
}

function collectTargets(root: HTMLElement): Array<{ el: HTMLElement; end: number }> {
	const targets: Array<{ el: HTMLElement; end: number }> = [];
	root.querySelectorAll<HTMLElement>("[data-stat-value]").forEach((el) => {
		const text = el.textContent?.trim() ?? "";
		if (!isCountable(text)) return; // 「今天」等非数字跳过
		const end = Number(text.replaceAll(",", ""));
		if (Number.isFinite(end) && end > 0) targets.push({ el, end });
	});
	return targets;
}

function animateCounters(targets: Array<{ el: HTMLElement; end: number }>): void {
	targets.forEach(({ el, end }, index) => {
		el.textContent = "0";
		const counter = { v: 0 };
		animate(counter, {
			v: end,
			duration: 1000,
			delay: index * 80,
			ease: "outExpo",
			onUpdate: () => {
				el.textContent = Math.round(counter.v).toLocaleString();
			},
			onComplete: () => {
				el.textContent = end.toLocaleString();
			},
		});
	});
}

function setupCountUp() {
	// 切页（swup 容器含 sidebar-dynamic）会重渲染本组件，会话内只播一次
	if (sessionStorage.getItem(COUNTED_KEY)) return;

	// #site-stats 会同时存在桌面/移动两份（其中一份可能被隐藏或 0×0），
	// 不能用 getElementById——逐个观察、由第一个真正可见的实例触发。
	// 0×0 的隐藏副本必须滤掉：零面积元素会被 IntersectionObserver 特判为
	// isIntersecting（哪怕在视口里只有个原点），否则它会抢跑守卫、害死可见副本
	const roots = Array.from(document.querySelectorAll<HTMLElement>("#site-stats")).filter(
		(root) =>
			root.dataset.countUpReady !== "1" && root.getBoundingClientRect().width > 0,
	);
	if (roots.length === 0) return;

	if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		sessionStorage.setItem(COUNTED_KEY, "1");
		return;
	}

	roots.forEach((root) => {
		root.dataset.countUpReady = "1";
		const targets = collectTargets(root);
		if (targets.length === 0) return;

		const observer = new IntersectionObserver(
			(entries) => {
				// 另一份实例先触发过就不再重复播
				if (sessionStorage.getItem(COUNTED_KEY)) {
					observer.disconnect();
					return;
				}
				const hit = entries.find(
					(entry) => entry.isIntersecting && entry.boundingClientRect.width > 0,
				);
				if (!hit) return;
				observer.disconnect();
				sessionStorage.setItem(COUNTED_KEY, "1"); // 真正播过才记，播前切页可换页重试
				animateCounters(targets);
			},
			{ threshold: 0.3 },
		);
		observer.observe(root);
	});
}

setupCountUp();
// swup 切页后新 DOM 就绪的可靠事件（勿用 swup:contentReplaced 死事件）
document.addEventListener("astro:page-load", setupCountUp);
</script>
