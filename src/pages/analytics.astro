			const updateTooltip = (index) => {
				const point = points[Math.max(0, Math.min(points.length - 1, index))];
				if (!point || !tooltip || !guide) return;
				const coordinate = viewCoordinates[Math.max(0, Math.min(viewCoordinates.length - 1, index))];
				guide.setAttribute("x1", coordinate.x.toFixed(2));
				guide.setAttribute("x2", coordinate.x.toFixed(2));
				guide.style.display = "block";
				tooltip.hidden = false;
				tooltip.querySelector("[data-chart-tooltip-date]").textContent = point.key.replaceAll("-", ".");
				tooltip.querySelector("[data-chart-tooltip-views]").textContent = formatNumber(point.views);
				tooltip.querySelector("[data-chart-tooltip-sessions]").textContent = formatNumber(point.sessions);
