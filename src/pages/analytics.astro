			const startedAt = animationClock.start();
			const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
			values.forEach((element) => {
				const previousFrame = rankingAnimationFrames.get(element);
				if (previousFrame) cancelAnimationFrame(previousFrame);
				const target = Math.max(0, Math.round(Number(element.dataset.rankingTarget) || 0));
				const line = element.closest("[data-ranking-scale-target]");
				const lineTarget = Math.max(0, Math.min(1, Number(line?.dataset.rankingScaleTarget) || 0));
				const applyFrame = (progress) => {
					const eased = easeCountProgress(progress);
					element.textContent = formatNumber(target * eased);
