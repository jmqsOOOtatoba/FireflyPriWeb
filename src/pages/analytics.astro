					const generationProgress = easeCountProgress(Math.min(1, progress / generationEnd));
					cells.forEach((cell, index) => {
						const reveal = Math.max(0, Math.min(1, generationProgress * (cells.length + 1) - index));
						setCellReveal(cell, reveal);
					});

					const rhythmProgress = easeCountProgress(Math.max(0, Math.min(1, (progress - generationEnd) / (rhythmEnd - generationEnd))));
					const rhythmIndex = activeCells.length && progress >= generationEnd
						? Math.min(activeCells.length - 1, Math.floor(rhythmProgress * activeCells.length))
						: -1;
					activeCells.forEach((cell, index) => {
						const isCurrent = index === rhythmIndex && progress < rhythmEnd;
						cell.dataset.pushRhythmState = index <= rhythmIndex ? "lit" : "pending";
						cell.classList.toggle("is-push-rhythm-active", isCurrent);
						if (isCurrent) {
							const cellStart = rhythmIndex / activeCells.length;
							const localProgress = Math.max(0, Math.min(1, (rhythmProgress - cellStart) * activeCells.length));
							const pulse = localProgress <= 0.5 ? localProgress * 2 : 2 - localProgress * 2;
							cell.style.setProperty("--push-rhythm-pulse", pulse.toFixed(3));
						} else {
							cell.style.removeProperty("--push-rhythm-pulse");
						}
					});

					if (progress < generationEnd) heatmapGrid.dataset.pushAnimationPhase = "generating";
					else if (progress < rhythmEnd) heatmapGrid.dataset.pushAnimationPhase = "rhythm";
					else {
						heatmapGrid.dataset.pushAnimationPhase = "snake";
						if (!snakeStarted) {
							snakeStarted = true;
							snake.start();
						}
						snake.setRevealProgress(easeCountProgress(Math.max(0, Math.min(1, (progress - rhythmEnd) / (1 - rhythmEnd)))));
					}

					if (progress < 1) {
						pushAnimationFrame = requestAnimationFrame(tick);
						return;
					}
					finish();
				};
				pushAnimationFrame = requestAnimationFrame(tick);
			};
			const renderCurrentHeatmap = () => {
				renderedHeatmapWeeks = getHeatmapWeeks();
				renderedHeatmapWidth = Math.round(heatmapScroll?.getBoundingClientRect().width || panel.getBoundingClientRect().width || window.innerWidth);
				renderPushHeatmap(panel, pushTimestamps, "推送", selectedMode, renderedHeatmapWeeks);
				snake.refresh({ deferStart: true });
				animatePushHeatmap();
				if (heatmapDetail) heatmapDetail.textContent = defaultHeatmapDetail;
			};
			const resetHeatmapDetail = () => {
				if (heatmapDetail) heatmapDetail.textContent = defaultHeatmapDetail;
			};
			const handleHeatmapFocusout = (event) => {
				if (!heatmapGrid?.contains(event.relatedTarget)) resetHeatmapDetail();
			};
			const handleAnimationReplay = () => renderCurrentHeatmap();
			window.addEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
			heatmapGrid?.addEventListener("pointerleave", resetHeatmapDetail);
			heatmapGrid?.addEventListener("focusout", handleHeatmapFocusout);
			const heatmapResizeObserver = typeof ResizeObserver === "function" && heatmapScroll
				? new ResizeObserver(() => {
					const width = Math.round(heatmapScroll.getBoundingClientRect().width);
					if (getHeatmapWeeks() !== renderedHeatmapWeeks || width !== renderedHeatmapWidth) renderCurrentHeatmap();
				})
				: null;
			heatmapResizeObserver?.observe(heatmapScroll);
			const selectMode = (mode) => {
				selectedMode = mode;
				modeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.pushHeatmapMode === selectedMode)));
				renderCurrentHeatmap();
			};
			const selectSnakeSpeed = (value) => {
				snakeSpeedButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.pushSnakeSpeed === value)));
				snake.setSpeedMultiplier(value);
			};
			const selectFoodGrowth = (value) => {
				snakeFoodCapacityButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.pushSnakeFoodCapacity === value)));
				snake.setFoodGrowthMultiplier(value);
			};
			selectSnakeSpeed(selectedSnakeSpeed);
			selectFoodGrowth(selectedFoodGrowth);
			const modeHandlers = modeButtons.map((button) => {
				const handler = () => selectMode(button.dataset.pushHeatmapMode || "daily");
				button.addEventListener("click", handler);
				return [button, handler];
			});
			const snakeSpeedHandlers = snakeSpeedButtons.map((button) => {
				const handler = () => selectSnakeSpeed(button.dataset.pushSnakeSpeed || "1");
				button.addEventListener("click", handler);
				return [button, handler];
			});
			const snakeFoodCapacityHandlers = snakeFoodCapacityButtons.map((button) => {
				const handler = () => selectFoodGrowth(button.dataset.pushSnakeFoodCapacity || "1");
				button.addEventListener("click", handler);
				return [button, handler];
			});

			const controller = new AbortController();
			const load = async () => {
				try {
					const pushesPayload = await fetchJson(`/api/github-pushes.json?t=${Date.now()}`, {
						headers: { Accept: "application/json" },
						signal: controller.signal,
					}, 5000);
					if (controller.signal.aborted) return;

					pushTimestamps = (Array.isArray(pushesPayload?.commits) ? pushesPayload.commits : [])
						.map((value) => new Date(value).getTime())
						.filter((value) => Number.isFinite(value))
						.sort((a, b) => b - a);
					renderCurrentHeatmap();
					if (!pushTimestamps.length) {
						setText(status, "待记录");
						setText(latest, "—");
						setText(latestBadge, "—");
						setText(interval, "—");
						setText(average, "—");
						setText(streak, "—");
						setText(streakNote, "等待第一次推送");
						setText(count, "—");
						setText(note, "等待 GitHub main 分支的下一次推送");
						return;
					}

					setText(status, "已记录");
					setText(latest, dateTimeFormatter.format(new Date(pushTimestamps[0])));
					const latestAgeSeconds = Math.max(0, (Date.now() - pushTimestamps[0]) / 1000);
					setText(latestBadge, latestAgeSeconds < 60 ? "刚刚" : `${formatDeploymentDuration(latestAgeSeconds)}前`);
					const streakDays = getPushDayStreak(pushTimestamps);
					setText(streak, streakDays ? `${streakDays} 天` : "—");
					setText(streakNote, streakDays > 1 ? "保持连续更新" : "从今天开始");
					setText(count, `最近 ${getActionAdjustedTotal(pushTimestamps)} 次`);
					if (pushTimestamps.length < 2) {
						setText(interval, "首次推送");
						setText(average, "等待下一次");
						setText(note, "按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions");
						return;
					}

					const intervals = pushTimestamps.slice(0, -1).map((value, index) => value - pushTimestamps[index + 1]);
					const latestInterval = intervals[0] / 1000;
					const averageInterval = intervals.reduce((sum, value) => sum + value, 0) / intervals.length / 1000;
					setText(interval, formatDeploymentDuration(latestInterval));
					setText(average, formatDeploymentDuration(averageInterval));
					setText(note, "按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions");
				} catch (error) {
					if (error?.name === "AbortError") return;
					setText(status, "暂不可用");
					setText(latest, "—");
					setText(latestBadge, "—");
					setText(interval, "—");
					setText(average, "—");
					setText(streak, "—");
					setText(streakNote, "等待接口恢复");
					setText(count, "—");
					setText(note, "GitHub 推送记录接口暂时没有响应");
					pushTimestamps = [];
					renderCurrentHeatmap();
				}
			};

			load();
			return () => {
				controller.abort();
				if (pushAnimationFrame) cancelAnimationFrame(pushAnimationFrame);
				heatmapResizeObserver?.disconnect();
				snake.destroy();
				window.removeEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
				heatmapGrid?.removeEventListener("pointerleave", resetHeatmapDetail);
				heatmapGrid?.removeEventListener("focusout", handleHeatmapFocusout);
				modeHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
				snakeSpeedHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
				snakeFoodCapacityHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
