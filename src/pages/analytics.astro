			const descriptionElement = document.createElement("small");
			descriptionElement.textContent = description;
			item.append(titleElement, descriptionElement);
			list.replaceChildren(item);
			list.dataset.commentsState = "empty";
			list.dataset.commentsAnimationPhase = "idle";
		};

		const renderRecentComments = (root, payload) => {
			const list = root.querySelector("[data-comments-list]");
			const status = root.querySelector("[data-comments-status]");
			if (!list) return;

			const comments = getRecentCommentRows(payload)
				.filter((comment) => comment && typeof comment === "object")
				.map((comment) => {
					const nick = cleanCommentText(comment.nick, "访客");
					const text = cleanCommentText(comment.comment);
					const insertedAt = comment.date || comment.created;
					const page = getCommentPage(comment.url);
					return { nick, text, insertedAt, page };
				})
				.filter(({ text }) => Boolean(text))
				.slice(0, 8);

			if (!comments.length) {
				showCommentsMessage(root, "暂时还没有公开评论", "有新的留言后，它会出现在这里。");
