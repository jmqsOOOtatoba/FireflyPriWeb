			grid.replaceChildren();
			months.replaceChildren();
			const maxWeeklyCount = Math.max(0, ...weekCounts.values());
			const totalCount = [...weekCounts.values()].reduce((sum, count) => sum + count, 0);
			let cumulativeCount = 0;
			const appendCell = (date, count, isFuture, isCurrentPeriod = false, level = null, stateLabel = "", rhythmOrder = 0) => {
				const label = dateFormatter.format(date);
				const cell = document.createElement("button");
				cell.type = "button";
				cell.className = "analytics-deployment__cell";
				const finalLevel = isFuture ? "future" : String(level ?? Math.min(count, 4));
				cell.dataset.level = finalLevel;
				cell.dataset.pushAnimationIndex = String(grid.childElementCount);
				cell.dataset.pushRhythmOrder = String(rhythmOrder);
				cell.dataset.pushCount = String(Math.max(0, Number(count) || 0));
				cell.dataset.pushActive = finalLevel !== "0" && finalLevel !== "future" ? "true" : "false";
				cell.setAttribute("aria-label", `${label}${mode === "daily" ? "" : " 这一周"}：${isFuture ? "尚未到达" : count ? `${count} 次${noun}` : `没有${noun}记录`}${stateLabel}`);
				cell.title = cell.getAttribute("aria-label");
				cell.disabled = isFuture;
				if (isCurrentPeriod) cell.classList.add("is-today");
				cell.addEventListener("pointerenter", () => setDetail(date, count));
				cell.addEventListener("focus", () => setDetail(date, count));
				grid.append(cell);
			};

			for (let week = 0; week < heatmapWeeks; week += 1) {
				const weekStart = new Date(firstDay);
				weekStart.setUTCDate(firstDay.getUTCDate() + week * 7);
				const previousWeekStart = week > 0 ? new Date(firstDay) : null;
				if (previousWeekStart) previousWeekStart.setUTCDate(firstDay.getUTCDate() + (week - 1) * 7);
				if (week === 0 || monthFormatter.format(weekStart) !== monthFormatter.format(previousWeekStart)) {
					const monthLabel = document.createElement("span");
					monthLabel.textContent = monthFormatter.format(weekStart);
					monthLabel.style.gridColumn = String(week + 1);
					if (week === heatmapWeeks - 1) {
