			chart.classList.toggle("is-empty", total === 0);

			let chartAnimationFrame;
			let chartAnimationStarted = false;
			const animatedPaths = [viewLine, sessionLine];
			const shouldAnimate = total > 0;
			animatedPaths.forEach((path) => {
				path.style.clipPath = shouldAnimate ? "inset(0 100% 0 0)" : "";
			});
			area.style.opacity = shouldAnimate ? "0" : "";
			const finishChartAnimation = () => {
				animatedPaths.forEach((path) => {
					path.style.clipPath = "";
				});
