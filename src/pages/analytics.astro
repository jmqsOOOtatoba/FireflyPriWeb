					element.textContent = formatNumber(target);
					if (line) {
						line.dataset.rankingAnimating = "false";
						line.style.setProperty("--ranking-scale", String(lineTarget));
					}
					return;
				}
				if (line) {
					line.dataset.rankingAnimating = "true";
					line.style.setProperty("--ranking-scale", "0");
