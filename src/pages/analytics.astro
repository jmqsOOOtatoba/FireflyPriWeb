---
import { Icon } from "astro-icon/components";
import { analyticsConfig, commentConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export const prerender = true;

const umamiAnalytics = analyticsConfig.umamiAnalytics;
const twikooServer =
	commentConfig.type === "twikoo" ? (commentConfig.twikoo?.envId ?? "") : "";
const shareId = umamiAnalytics?.shareId ?? "";
const shareApiBase = umamiAnalytics?.shareApiBase ?? "";
const publicShareUrl =
	shareApiBase && shareId
		? `${shareApiBase.replace(/\/+$/, "")}/share/${encodeURIComponent(shareId)}`
		: "";
const historicalVisitors = umamiAnalytics?.historicalStats?.visitors ?? 0;
const historicalPageviews = umamiAnalytics?.historicalStats?.pageviews ?? 0;
const hasPublicStats = Boolean(
	umamiAnalytics?.websiteId && shareId && shareApiBase,
);
const sourceLabel = shareApiBase.includes("cloud.umami.is")
	? "Umami Cloud"
	: "Umami";
---

<MainGridLayout title="站点统计" description="基于 Umami 的公开站点访问统计">
	<section
		class="analytics-page"
		data-umami-dashboard
		data-share-id={shareId}
		data-api-base={shareApiBase}
		data-historical-visitors={historicalVisitors}
		data-historical-pageviews={historicalPageviews}
		data-ready={hasPublicStats ? "true" : "false"}
		aria-labelledby="analytics-title"
	>
		<header class="analytics-hero card-base onload-animation">
			<div class="analytics-hero__grid">
				<div class="analytics-hero__copy">
					<div class="analytics-kicker">
						<span class="analytics-kicker__signal" aria-hidden="true"></span>
						<span>UMAMI / PUBLIC TELEMETRY</span>
					</div>
					<h1 id="analytics-title">站点统计</h1>
					<p class="analytics-hero__lead">
						这里展示的是本站的整体趋势，不记录任何可识别个人身份的信息。
					</p>
					<div class="analytics-hero__notes">
						<span><Icon is:inline name="material-symbols:lock-open-rounded" aria-hidden="true" />公开只读</span>
						<span><Icon is:inline name="material-symbols:calendar-today-rounded" aria-hidden="true" />按北京时间汇总</span>
					</div>
				</div>

				<div class="analytics-hero__meta">
					<div class="analytics-status" data-analytics-status data-state="loading" role="status" aria-live="polite">
						<span class="analytics-status__dot" aria-hidden="true"></span>
						<span data-analytics-status-text>连接中</span>
					</div>
					<div class="analytics-hero__stamp">
						<span>DATA SOURCE</span>
						<strong>{sourceLabel}</strong>
						<small data-analytics-last-update>公开分享数据 · 自动刷新</small>
					</div>
				</div>
			</div>

			<div class="analytics-hero__rail" aria-hidden="true">
				<span>MST / 2026</span>
				<span></span>
				<span>MEASURE WHAT MATTERS</span>
			</div>
		</header>

		<section class="analytics-summary" aria-label="站点概览">
			<article class="analytics-summary-card analytics-summary-card--blue card-base">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">ALL-TIME</span>
					<Icon is:inline name="material-symbols:group-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="visitors" aria-live="polite">加载中</strong>
				<span>累计访客</span>
				<small>含迁移前历史累计</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--mint card-base">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">ALL-TIME</span>
					<Icon is:inline name="material-symbols:visibility-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="pageviews" aria-live="polite">加载中</strong>
				<span>累计浏览</span>
				<small>含迁移前历史累计</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--gold card-base">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">TODAY</span>
					<Icon is:inline name="material-symbols:person-search-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="todayVisitors" aria-live="polite">加载中</strong>
				<span>今日访客</span>
				<small>北京时间 00:00 起</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--violet card-base">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">TODAY</span>
					<Icon is:inline name="material-symbols:trending-up-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="todayPageviews" aria-live="polite">加载中</strong>
				<span>今日浏览</span>
				<small>实时公开数据</small>
			</article>
		</section>

		<div class="analytics-layout">
			<main class="analytics-main">
				<section class="analytics-panel analytics-traffic card-base" aria-labelledby="analytics-traffic-title">
					<header class="analytics-panel__header">
						<div>
							<p class="analytics-section-kicker">TRAFFIC / SIGNAL</p>
							<h2 id="analytics-traffic-title">访问脉冲</h2>
							<p class="analytics-panel__description">每天的浏览量与访客数 · 刷新可重播动画</p>
						</div>
						<div class="analytics-panel__controls">
							<div class="analytics-range" role="group" aria-label="选择统计时间范围">
								<button type="button" data-range="7" aria-pressed="false">7 天</button>
								<button type="button" data-range="30" aria-pressed="true">30 天</button>
								<button type="button" data-range="90" aria-pressed="false">90 天</button>
							</div>
							<button type="button" class="analytics-refresh" data-analytics-refresh aria-label="刷新统计数据并重播动画">
								<Icon is:inline name="material-symbols:refresh-rounded" aria-hidden="true" />
							</button>
						</div>
					</header>

					<div class="analytics-chart-wrap">
						<div class="analytics-chart-labels" aria-hidden="true">
							<span data-chart-y-label="max">—</span>
							<span data-chart-y-label="mid">—</span>
							<span data-chart-y-label="min">0</span>
						</div>
						<svg
							class="analytics-chart"
							data-traffic-chart
							viewBox="0 0 960 300"
							role="img"
							aria-label="最近 30 天的浏览量与访客趋势"
						>
							<defs>
								<linearGradient id="analytics-area-gradient" x1="0" x2="0" y1="0" y2="1">
									<stop offset="0%" stop-color="var(--analytics-blue)" stop-opacity="0.24" />
									<stop offset="100%" stop-color="var(--analytics-blue)" stop-opacity="0" />
								</linearGradient>
							</defs>
							<g class="analytics-chart__grid" aria-hidden="true">
								<line x1="42" y1="38" x2="944" y2="38"></line>
								<line x1="42" y1="134" x2="944" y2="134"></line>
								<line x1="42" y1="230" x2="944" y2="230"></line>
							</g>
							<path class="analytics-chart__area" data-chart-area d="M 42 230 L 944 230 Z"></path>
							<path class="analytics-chart__line analytics-chart__line--views" data-chart-line="views" d="M 42 230 L 944 230"></path>
							<path class="analytics-chart__line analytics-chart__line--sessions" data-chart-line="sessions" d="M 42 230 L 944 230"></path>
							<line class="analytics-chart__guide" data-chart-guide x1="42" y1="24" x2="42" y2="230" style="display:none"></line>
							<g data-chart-points></g>
							<g class="analytics-chart__endpoints" data-chart-endpoints aria-hidden="true"></g>
						</svg>
						<div class="analytics-chart__tooltip" data-chart-tooltip hidden>
							<strong data-chart-tooltip-date>—</strong>
							<span><i class="analytics-legend-dot analytics-legend-dot--blue"></i><b data-chart-tooltip-views>—</b> 浏览</span>
							<span><i class="analytics-legend-dot analytics-legend-dot--gold"></i><b data-chart-tooltip-sessions>—</b> 访客</span>
						</div>
						<div class="analytics-chart__x-axis" aria-hidden="true">
							<span data-chart-x-label="start">—</span>
							<span data-chart-x-label="middle">—</span>
							<span data-chart-x-label="end">今天</span>
						</div>
						<div class="analytics-chart-empty" data-chart-empty hidden>
							<Icon is:inline name="material-symbols:query-stats-rounded" aria-hidden="true" />
							<strong>暂时没有可展示的趋势</strong>
							<span>公开数据接口暂时没有返回这段时间的记录。</span>
						</div>
					</div>

					<footer class="analytics-chart-footer">
						<div class="analytics-chart-legend" aria-label="图表图例">
							<span><i class="analytics-legend-dot analytics-legend-dot--blue"></i>浏览量</span>
							<span><i class="analytics-legend-dot analytics-legend-dot--gold"></i>访客</span>
						</div>
					</footer>

					<div class="analytics-traffic__details">
					<section class="analytics-traffic__period analytics-snapshot" data-analytics-period aria-labelledby="analytics-period-title">
						<div class="analytics-traffic__period-heading">
							<div class="analytics-snapshot__intro">
								<div>
									<strong id="analytics-period-title">本周期数据</strong>
									<span>近 30 天 · 北京时间</span>
								</div>
							</div>
							</div>

						<div class="analytics-snapshot__metrics" aria-label="近 30 天访问概览">
							<div class="analytics-snapshot__metric analytics-snapshot__metric--blue">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--blue" aria-hidden="true"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>浏览量</span><small data-snapshot-change="pageviews">等待数据</small></span>
								<strong data-snapshot-stat="pageviews">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--pink">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--pink" aria-hidden="true"><Icon is:inline name="material-symbols:group-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>访客数</span><small data-snapshot-change="visitors">等待数据</small></span>
								<strong data-snapshot-stat="visitors">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--mint">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--mint" aria-hidden="true"><Icon is:inline name="material-symbols:calendar-month-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>活跃天数</span><small>有访问记录的日期</small></span>
								<strong data-snapshot-stat="activeDays">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--gold">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--gold" aria-hidden="true"><Icon is:inline name="material-symbols:trending-up-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>单日峰值</span><small>最高浏览量</small></span>
								<strong data-snapshot-stat="peak">—</strong>
							</div>
						</div>
					</section>

					<section class="analytics-traffic__ranking analytics-ranking-panel" aria-labelledby="analytics-pages-title">
							<header class="analytics-traffic__section-heading">
								<strong id="analytics-pages-title">大家在看什么</strong>
								<span>近 30 天 · 访客</span>
							</header>
					<ol class="analytics-ranking" data-ranking-list>
						{Array.from({ length: 4 }, (_, index) => (
							<li class="analytics-ranking__item analytics-skeleton-row" data-ranking-skeleton>
								<span class="analytics-ranking__index">{String(index + 1).padStart(2, "0")}</span>
								<span class="analytics-ranking__copy"><i></i><em></em></span>
								<strong>—</strong>
							</li>
						))}
					</ol>
						</section>
					</div>
				</section>

				<section class="analytics-panel analytics-deployment card-base" aria-labelledby="analytics-push-title" data-push-rhythm>
				<header class="analytics-panel__header analytics-panel__header--compact analytics-deployment__header">
					<div class="analytics-deployment__heading">
						<p class="analytics-section-kicker">OPERATIONS / RELEASES</p>
						<h2 id="analytics-push-title">推送节奏</h2>
						<p class="analytics-panel__description">按 GitHub main 分支推送时间观察活动密度</p>
					</div>
					<div class="analytics-deployment__art" aria-hidden="true">
						<p>持续热爱，<br />一直在更新！</p>
						<span>♥</span>
					</div>
					<span class="analytics-panel__badge analytics-deployment__status" data-push-status>读取中</span>
				</header>
				<div class="analytics-deployment__metrics">
					<div class="analytics-deployment__metric analytics-deployment__metric--latest analytics-deployment__metric--blue">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:schedule-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>最近一次推送</span>
							<strong data-push-latest>—</strong>
						</span>
						<em data-push-latest-badge>—</em>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--pink">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:calendar-month-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>最近间隔</span>
							<strong data-push-interval>—</strong>
							<small>保持活跃 ✦</small>
						</span>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--blue">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>平均节奏</span>
							<strong data-push-average>—</strong>
							<small>基于全部推送</small>
						</span>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--violet">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:local-fire-department-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>连续推送</span>
							<strong data-push-streak>—</strong>
							<small data-push-streak-note>继续加油！</small>
						</span>
					</div>
				</div>
					<div class="analytics-deployment__heatmap" data-push-heatmap>
						<div class="analytics-deployment__heatmap-head">
							<div class="analytics-deployment__heatmap-title"><strong>推送活动</strong><span title="每格代表一天，颜色越深表示推送越多" aria-label="每格代表一天，颜色越深表示推送越多"><Icon is:inline name="material-symbols:info-outline-rounded" aria-hidden="true" /></span></div>
							<div class="analytics-deployment__snake-controls" aria-label="贪吃蛇设置">
								<div class="analytics-deployment__snake-control" role="group" aria-label="蛇速度">
									<span>蛇速度</span>
									<div class="analytics-deployment__snake-options">
										<button type="button" data-push-snake-speed="1" aria-pressed="true">1x</button>
										<button type="button" data-push-snake-speed="2" aria-pressed="false">2x</button>
										<button type="button" data-push-snake-speed="5" aria-pressed="false">5x</button>
									</div>
								</div>
								<div class="analytics-deployment__snake-control" role="group" aria-label="食物容量，每个食物增长格数">
									<span>食物容量</span>
									<div class="analytics-deployment__snake-options">
										<button type="button" data-push-snake-food-capacity="1" aria-pressed="true" title="吃一个食物增长 1 格">1x</button>
										<button type="button" data-push-snake-food-capacity="2" aria-pressed="false" title="吃一个食物增长 2 格">2x</button>
										<button type="button" data-push-snake-food-capacity="5" aria-pressed="false" title="吃一个食物增长 5 格">5x</button>
									</div>
								</div>
							</div>
							<div class="analytics-deployment__heatmap-tabs" role="group" aria-label="热力图时间粒度">
								<button type="button" data-push-heatmap-mode="daily" aria-pressed="true">每日</button>
								<button type="button" data-push-heatmap-mode="weekly" aria-pressed="false">每周</button>
								<button type="button" data-push-heatmap-mode="cumulative" aria-pressed="false">累计</button>
							</div>
						</div>
						<div class="analytics-deployment__heatmap-scroll" data-push-heatmap-scroll>
							<div class="analytics-deployment__heatmap-layout">
								<div class="analytics-deployment__heatmap-main">
									<div class="analytics-deployment__heatmap-grid" data-push-heatmap-grid role="grid" aria-label="近一年 GitHub 推送活动，每格代表一天，颜色越深表示当天推送越多"></div>
									<div class="analytics-deployment__months" data-push-heatmap-months aria-hidden="true"></div>
								</div>
							</div>
						</div>
						<div class="analytics-deployment__heatmap-foot">
							<span class="analytics-deployment__source"><Icon is:inline name="simple-icons:github" aria-hidden="true" /><span data-push-note>按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions</span></span>
							<span class="analytics-deployment__heatmap-legend" aria-label="推送次数图例">
								<span>少</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>多</span>
							</span>
							<strong data-push-count>—</strong>
						</div>
						<div class="analytics-deployment__message">
							<span class="analytics-deployment__message-icon" aria-hidden="true"><Icon is:inline name="material-symbols:lightbulb-rounded" /></span>
							<div><strong data-push-heatmap-detail>快来和小蛇蛇交互一下。</strong><span>「每一次推送，都是让想法变成现实的一小步。」</span></div>
							<Icon class="analytics-deployment__message-plane" is:inline name="material-symbols:send-rounded" aria-hidden="true" />
						</div>
					</div>
				</section>

				<section
					class="analytics-panel analytics-activity card-base"
					aria-labelledby="analytics-activity-title"
					data-visitor-activity
				>
					<header class="analytics-panel__header analytics-activity__header">
						<div class="analytics-activity__heading">
							<p class="analytics-section-kicker">VISITOR / ACTIVITY</p>
							<div class="analytics-activity__title-row">
								<h2 id="analytics-activity-title">访客活跃时间</h2>
								<span class="analytics-panel__badge analytics-activity__range">近 30 天</span>
							</div>
							<p class="analytics-panel__description">看看大家通常在什么时候来这里</p>
						</div>
					</header>

					<div class="analytics-activity__body">
						<div class="analytics-activity__heatmap-wrap">
							<div class="analytics-activity__heatmap" data-activity-heatmap>
								<div class="analytics-activity__hours" aria-hidden="true">
									{Array.from({ length: 12 }, (_, index) => <span>{String(index * 2).padStart(2, "0")}时</span>)}
								</div>
								<div class="analytics-activity__days" aria-hidden="true">
									{["周一", "周二", "周三", "周四", "周五", "周六", "周日"].map((day) => <span>{day}</span>)}
								</div>
								<div class="analytics-activity__grid" data-activity-grid role="grid" aria-label="近 30 天访客按星期与小时的活跃分布">
									{Array.from({ length: 7 * 24 }, (_, index) => {
										const weekday = Math.floor(index / 24);
										const hour = index % 24;
										return <button type="button" class="analytics-activity__cell" data-activity-cell data-weekday={weekday} data-hour={hour} aria-label={`${["周一", "周二", "周三", "周四", "周五", "周六", "周日"][weekday]} ${String(hour).padStart(2, "0")}:00，等待数据`}></button>;
									})}
								</div>
							</div>
							<p class="analytics-activity__note" data-activity-note>正在读取近 30 天的小时级访问记录…</p>
						</div>

						<div class="analytics-activity__art" aria-hidden="true">
							<div class="analytics-activity__art-orbit"></div>
							<p>有你来，真好！ <span>♥</span></p>
						</div>
					</div>

					<div class="analytics-activity__stats" aria-label="访客活跃时间摘要">
						<div class="analytics-activity__stat analytics-activity__stat--blue">
							<span class="analytics-activity__stat-icon" aria-hidden="true"><Icon is:inline name="material-symbols:schedule-rounded" /></span>
							<span><small>最活跃时间</small><strong data-activity-stat="time">—</strong></span>
						</div>
						<div class="analytics-activity__stat analytics-activity__stat--pink">
							<span class="analytics-activity__stat-icon" aria-hidden="true"><Icon is:inline name="material-symbols:calendar-month-rounded" /></span>
							<span><small>最活跃星期</small><strong data-activity-stat="day">—</strong></span>
						</div>
						<div class="analytics-activity__stat analytics-activity__stat--mint">
							<span class="analytics-activity__stat-icon" aria-hidden="true"><Icon is:inline name="material-symbols:groups-rounded" /></span>
							<span><small>夜间访问占比</small><strong data-activity-stat="night">—</strong></span>
						</div>
						<div class="analytics-activity__stat analytics-activity__stat--gold">
							<span class="analytics-activity__stat-icon" aria-hidden="true"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
							<span><small>今日访客</small><strong data-umami-stat="todayVisitors" aria-live="polite">加载中</strong></span>
						</div>
					</div>

					<footer class="analytics-activity__footer">
						<span>按北京时间聚合 · 数据只保留统计维度</span>
						<span class="analytics-activity__legend" aria-label="访问活跃度图例"><span>少</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><i data-level="5"></i><span>多</span></span>
					</footer>
				</section>
			</main>

			<aside class="analytics-sidebar" aria-label="站点统计分布">
				<section
					class="analytics-panel card-base analytics-snapshot-panel"
					aria-labelledby="analytics-snapshot-title"
					data-analytics-snapshot
					data-share-id={shareId}
					data-api-base={shareApiBase}
					data-historical-visitors={historicalVisitors}
					data-historical-pageviews={historicalPageviews}
					data-ready={hasPublicStats ? "true" : "false"}
				>
					<header class="analytics-snapshot__header analytics-panel__header">
						<div>
							<p class="analytics-section-kicker">VISITORS / DEVICES</p>
							<h2 id="analytics-snapshot-title">设备与浏览器</h2>
							<p>访客从哪里来</p>
						</div>
						<Icon is:inline name="material-symbols:devices-rounded" aria-hidden="true" />
					</header>
					<section class="analytics-snapshot__distribution" aria-labelledby="analytics-snapshot-title">
						<div class="analytics-snapshot__breakdown" data-snapshot-breakdown="device" aria-label="设备分布">
							<div class="analytics-snapshot__breakdown-title"><span>设备分布</span></div>
							<div class="analytics-snapshot__breakdown-body">
								<div class="analytics-snapshot__donut" data-snapshot-donut aria-hidden="true">
									<svg class="analytics-snapshot__donut-svg" data-snapshot-donut-svg viewBox="0 0 100 100" focusable="false"></svg>
									<span><Icon is:inline name="material-symbols:desktop-windows-rounded" /></span>
								</div>
								<div class="analytics-snapshot__legend" data-snapshot-legend>
									<div class="analytics-snapshot__skeleton"></div>
									<div class="analytics-snapshot__skeleton"></div>
									<div class="analytics-snapshot__skeleton"></div>
								</div>
							</div>
						</div>

						<div class="analytics-snapshot__breakdown" data-snapshot-breakdown="browser" aria-label="浏览器分布">
							<div class="analytics-snapshot__breakdown-title"><span>浏览器偏好</span></div>
							<div class="analytics-snapshot__breakdown-body">
								<div class="analytics-snapshot__donut" data-snapshot-donut aria-hidden="true">
									<svg class="analytics-snapshot__donut-svg" data-snapshot-donut-svg viewBox="0 0 100 100" focusable="false"></svg>
									<span><Icon is:inline name="material-symbols:language" /></span>
								</div>
								<div class="analytics-snapshot__legend" data-snapshot-legend>
									<div class="analytics-snapshot__skeleton"></div>
									<div class="analytics-snapshot__skeleton"></div>
									<div class="analytics-snapshot__skeleton"></div>
								</div>
							</div>
						</div>
					</section>
				</section>

				<section class="analytics-panel analytics-sources card-base" aria-labelledby="analytics-sources-title" data-traffic-sources>
					<header class="analytics-sources__header">
						<h2 id="analytics-sources-title">流量来源 <span>/ TRAFFIC / SOURCES</span></h2>
						<span class="analytics-sources__range" data-source-range>近 30 天</span>
					</header>
					<div class="analytics-sources__body">
						<div class="analytics-sources__donut" data-source-donut role="img" aria-label="流量来源分布，读取中">
							<svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"></svg>
							<div class="analytics-sources__donut-label">
								<strong data-source-total>—</strong>
								<span>本周期访客</span>
							</div>
						</div>
						<ol class="analytics-sources__list" data-source-list aria-label="流量来源排行">
							{Array.from({ length: 5 }, () => (
								<li class="analytics-sources__item analytics-sources__item--loading"><span></span><i></i><b>—</b></li>
							))}
						</ol>
					</div>
					<a class="analytics-sources__link" href={publicShareUrl || "#"} target="_blank" rel="noopener noreferrer" aria-label="在 Umami 中查看详细来源">
						<span>查看详细来源</span>
						<Icon is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
					</a>
				</section>
			</aside>

			<section
				class="analytics-comments analytics-panel card-base"
				aria-labelledby="analytics-comments-title"
				data-recent-comments
				data-comment-server={twikooServer}
			>
				<header class="analytics-panel__header analytics-comments__header">
					<div>
						<p class="analytics-section-kicker">COMMUNITY / RECENT NOTES</p>
						<h2 id="analytics-comments-title">最近评论</h2>
						<p class="analytics-panel__description">有人来过，也留下了几句值得被看见的话。</p>
					</div>
					<div class="analytics-comments__header-meta">
						<span class="analytics-panel__badge">Twikoo · 最新 8 条</span>
						<a href="/guestbook/">去留言板</a>
					</div>
				</header>
				<ul class="analytics-comments__list" data-comments-list aria-live="polite">
					{Array.from({ length: 6 }, () => (
						<li class="analytics-comment analytics-comment--skeleton" data-comment-skeleton>
							<span class="analytics-comment__avatar"></span>
							<span class="analytics-comment__body">
								<span class="analytics-comment__skeleton-line analytics-comment__skeleton-line--name"></span>
								<span class="analytics-comment__skeleton-line analytics-comment__skeleton-line--meta"></span>
								<span class="analytics-comment__skeleton-line analytics-comment__skeleton-line--text"></span>
								<span class="analytics-comment__skeleton-line analytics-comment__skeleton-line--text-short"></span>
							</span>
						</li>
					))}
				</ul>
				<p class="analytics-comments__status" data-comments-status role="status" aria-live="polite">正在读取最近评论…</p>
			</section>
		</div>

		<footer class="analytics-footer card-base" data-analytics-footer>
			<div>
				<span class="analytics-footer__eyebrow">A SMALL PUBLIC RECORD</span>
				<strong>谢谢你来过，也谢谢你愿意留下几秒钟。</strong>
			</div>
			<a class="analytics-footer__link" href="/about/">回到关于我 <Icon is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" /></a>
		</footer>
	</section>

<script is:inline define:vars={{ hasPublicStats }}>
	(() => {
		const runtimeKey = "__rainztAnalyticsPageRuntime";
		const runtime = window[runtimeKey] || {
			activeRoot: null,
			cleanup: null,
			bound: false,
		};
		const timeZone = "Asia/Shanghai";
		const defaultActionRunsPerDay = 2;
		const numberFormatter = new Intl.NumberFormat("zh-CN");
		const animationClockKey = "__rainztAnalyticsAnimationClock";
		const datePartsFormatter = new Intl.DateTimeFormat("zh-CN", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		});
		const dateTimeFormatter = new Intl.DateTimeFormat("zh-CN", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
			hour: "2-digit",
			minute: "2-digit",
		});

		const clearRuntime = () => {
			if (typeof runtime.cleanup === "function") runtime.cleanup();
			runtime.cleanup = null;
			runtime.activeRoot = null;
		};

		const formatNumber = (value) => numberFormatter.format(Math.max(0, Math.round(Number(value) || 0)));
		const visualDuration = 4500;
		const easeCountProgress = (progress) => progress < 0.18
			? 0.08 * Math.pow(progress / 0.18, 2)
			: progress < 0.9
				? 0.08 + 0.82 * ((progress - 0.18) / 0.72)
				: 0.9 + 0.1 * (1 - Math.pow(1 - ((progress - 0.9) / 0.1), 3));
		const getAnimationClock = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			const current = window[animationClockKey];
			if (current?.root === root) return current;
			const clock = {
				root,
				duration: visualDuration,
				startedAt: null,
				start() {
					if (this.startedAt === null) this.startedAt = performance.now();
					return this.startedAt;
				},
				replay() {
					this.startedAt = null;
					window.dispatchEvent(new CustomEvent("rainzt-analytics-animation-replay"));
				},
			};
			window[animationClockKey] = clock;
			return clock;
		};
		const formatDeploymentDuration = (seconds) => {
			const totalMinutes = Math.max(1, Math.round(Number(seconds) / 60));
			if (totalMinutes < 60) return `约 ${totalMinutes} 分钟`;
			const totalHours = Math.round(totalMinutes / 60);
			if (totalHours < 24) return `约 ${totalHours} 小时`;
			const days = Math.floor(totalHours / 24);
			const hours = totalHours % 24;
			return hours ? `约 ${days} 天 ${hours} 小时` : `约 ${days} 天`;
		};
		const readRows = (value) => (Array.isArray(value) ? value : value?.data || []);
		// —— 最近评论（Twikoo）——
		const cleanCommentText = (value, fallback = "留下了一条评论") => {
			const text = String(value || "")
				.replace(/<[^>]*>/gu, " ")
				.replace(/&nbsp;/gu, " ")
				.replace(/\s+/gu, " ")
				.trim();
			return text || fallback;
		};
		const formatCommentTime = (value) => {
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) return "时间未知";
			const elapsed = Date.now() - date.getTime();
			if (elapsed < 60 * 1000) return "刚刚";
			if (elapsed < 60 * 60 * 1000) return `${Math.floor(elapsed / (60 * 1000))} 分钟前`;
			if (elapsed < 24 * 60 * 60 * 1000) return `${Math.floor(elapsed / (60 * 60 * 1000))} 小时前`;
			if (elapsed < 7 * 24 * 60 * 60 * 1000) return `${Math.floor(elapsed / (24 * 60 * 60 * 1000))} 天前`;
			return dateTimeFormatter.format(date);
		};
		const getRecentCommentRows = (payload) => {
			if (Array.isArray(payload)) return payload;
			if (Array.isArray(payload?.data)) return payload.data;
			if (Array.isArray(payload?.data?.data)) return payload.data.data;
			return [];
		};
		const isSafeHttpUrl = (value) => {
			if (typeof value !== "string" || !value.trim()) return false;
			try {
				return ["http:", "https:"].includes(new URL(value, window.location.origin).protocol);
			} catch {
				return false;
			}
		};
		const getCommentPage = (value) => {
			const rawPath = String(value || "").trim();
			if (!rawPath) return { label: "留言板", href: "/guestbook/" };
			try {
				const url = new URL(rawPath, window.location.origin);
				if (url.origin !== window.location.origin) return { label: "站点页面", href: "/" };
				const path = url.pathname || "/";
				return {
					label: path === "/" ? "首页" : path.length > 34 ? `${path.slice(0, 33)}…` : path,
					href: `${path}${url.search}${url.hash}`,
				};
			} catch {
				return { label: "站点页面", href: "/" };
			}
		};
		const dateKey = (value) => {
			const parts = datePartsFormatter.formatToParts(new Date(value));
			const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
			return `${map.year}-${map.month}-${map.day}`;
		};
		const getActionAdjustedDailyCounts = (timestamps) => {
			const rawCounts = new Map();
			for (const timestamp of timestamps) {
				const key = dateKey(timestamp);
				rawCounts.set(key, (rawCounts.get(key) || 0) + 1);
			}
			return new Map([...rawCounts.entries()].map(([key, value]) => [key, Math.max(0, value - defaultActionRunsPerDay)]));
		};
		const getActionAdjustedTotal = (timestamps) => [...getActionAdjustedDailyCounts(timestamps).values()]
			.reduce((sum, value) => sum + value, 0);
		const dateLabel = (key) => String(key || "").slice(5).replace("-", ".");
		const getLocalDayStart = () => {
			const now = new Date();
			now.setHours(0, 0, 0, 0);
			return now.getTime();
		};
		const getBeijingDayStart = () => {
			const parts = Object.fromEntries(
				new Intl.DateTimeFormat("en-CA", {
					timeZone,
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).formatToParts(new Date()).map((part) => [part.type, part.value]),
			);
			return Date.parse(`${parts.year}-${parts.month}-${parts.day}T00:00:00+08:00`);
		};

		const fetchJson = async (url, options = {}, timeoutMs = 8000) => {
			const timeoutController = new AbortController();
			let didTimeout = false;
			const timeoutId = window.setTimeout(() => {
				didTimeout = true;
				timeoutController.abort();
			}, timeoutMs);
			const sourceSignal = options.signal;
			const abortFromSource = () => timeoutController.abort();
			if (sourceSignal?.aborted) timeoutController.abort();
			else sourceSignal?.addEventListener("abort", abortFromSource, { once: true });

			try {
				const response = await fetch(url, {
					cache: "no-store",
					...options,
					signal: timeoutController.signal,
				});
				if (!response.ok) throw new Error(`umami ${response.status}`);
				return await response.json();
			} catch (error) {
				if (didTimeout) {
					const timeoutError = new Error(`request timeout after ${timeoutMs}ms`);
					timeoutError.name = "TimeoutError";
					throw timeoutError;
				}
				throw error;
			} finally {
				window.clearTimeout(timeoutId);
				sourceSignal?.removeEventListener("abort", abortFromSource);
			}
		};

		const readSharedShare = (shareId) => {
			try {
				const cached = JSON.parse(localStorage.getItem("rainzt:umami:share") || "null");
				if (
					cached?.tag === shareId &&
					cached?.value?.websiteId &&
					cached?.value?.token &&
					typeof cached.timestamp === "number" &&
					Date.now() - cached.timestamp < 24 * 60 * 60 * 1000
				) {
					return cached.value;
				}
			} catch {
				// The metrics widget may be unable to use localStorage; keep the live request path.
			}
			return null;
		};

		const fetchShare = async (apiBase, shareId, signal) => {
			const sharedShare = readSharedShare(shareId);
			if (sharedShare) return sharedShare;

			const encodedId = encodeURIComponent(shareId);
			const urls = [
				`${apiBase}/api/share/${encodedId}`,
				`${apiBase}/api/share/id/${encodedId}`,
			];
			let lastError;
			for (const url of urls) {
				try {
					const share = await fetchJson(url, { signal }, 6000);
					if (share?.websiteId && share?.token) return share;
					lastError = new Error("invalid public share");
				} catch (error) {
					if (error?.name === "AbortError" && signal?.aborted) throw error;
					lastError = error;
				}
			}
			throw lastError || new Error("public share unavailable");
		};

		const getCacheKey = (websiteId, range) => `rainzt:umami:dashboard:${websiteId}:${range}`;
		const readCache = (key) => {
			try {
				const cached = JSON.parse(localStorage.getItem(key) || "null");
				if (cached?.timestamp && Date.now() - cached.timestamp < 2 * 60 * 1000) return cached.value;
			} catch {
				// Private browsing may disable localStorage; the live request still works.
			}
			return null;
		};
		const writeCache = (key, value) => {
			try {
				localStorage.setItem(key, JSON.stringify({ timestamp: Date.now(), value }));
			} catch {
				// Ignore unavailable local storage.
			}
		};

		const setUmamiStatText = (key, value) => {
			const text = typeof value === "number" ? formatNumber(value) : String(value);
			document.querySelectorAll(`[data-umami-stat="${key}"]`).forEach((element) => {
				element.textContent = text;
			});
		};

		const setupSummaryCards = (root, apiBase, shareId) => {
			const historicalVisitors = Number(root.dataset.historicalVisitors) || 0;
			const historicalPageviews = Number(root.dataset.historicalPageviews) || 0;
			if (!apiBase || !shareId) {
				["visitors", "pageviews", "todayVisitors", "todayPageviews"].forEach((key) => {
					setUmamiStatText(key, "暂不可用");
				});
				return () => {};
			}
			const controller = new AbortController();
			const load = async () => {
				try {
					const share = await fetchShare(apiBase, shareId, controller.signal);
					const headers = {
						"x-umami-share-token": share.token,
						"x-umami-share-context": "1",
					};
					const endAt = Date.now();
					const startAt = getBeijingDayStart();
					const buildUrl = (start, end) => {
						const url = new URL(`${apiBase}/api/websites/${share.websiteId}/stats`);
						url.searchParams.set("startAt", String(start));
						url.searchParams.set("endAt", String(end));
						return url;
					};
					const [allTime, today] = await Promise.all([
						fetchJson(buildUrl(0, endAt), { headers, signal: controller.signal }),
						fetchJson(buildUrl(startAt, endAt), { headers, signal: controller.signal }),
					]);
					if (controller.signal.aborted) return;
					setUmamiStatText("visitors", (Number(allTime?.visitors?.value) || 0) + historicalVisitors);
					setUmamiStatText("pageviews", (Number(allTime?.pageviews?.value) || 0) + historicalPageviews);
					setUmamiStatText("todayVisitors", Number(today?.visitors?.value) || 0);
					setUmamiStatText("todayPageviews", Number(today?.pageviews?.value) || 0);
				} catch (error) {
					if (error?.name === "AbortError") return;
					["visitors", "pageviews", "todayVisitors", "todayPageviews"].forEach((key) => {
						setUmamiStatText(key, "暂不可用");
					});
				}
			};
			load();
			return () => controller.abort();
		};

		const drawChart = (root, pageviewRows, sessionRows, range) => {
			const chart = root.querySelector("[data-traffic-chart]");
			const area = root.querySelector("[data-chart-area]");
			const viewLine = root.querySelector('[data-chart-line="views"]');
			const sessionLine = root.querySelector('[data-chart-line="sessions"]');
			const pointLayer = root.querySelector("[data-chart-points]");
			const endpointLayer = root.querySelector("[data-chart-endpoints]");
			if (!chart || !area || !viewLine || !sessionLine || !pointLayer) return;
			const isInitialRender = chart.dataset.chartReady !== "true";
			if (isInitialRender) chart.classList.add("is-chart-initializing");

			const makeMap = (rows) => {
				const map = new Map();
				for (const row of rows) map.set(dateKey(row?.x || row?.t), Number(row?.y) || 0);
				return map;
			};
			const views = makeMap(pageviewRows);
			const sessions = makeMap(sessionRows);
			const lastDay = getLocalDayStart();
			const points = Array.from({ length: range }, (_, index) => {
				const date = new Date(lastDay - (range - 1 - index) * 24 * 60 * 60 * 1000);
				const key = dateKey(date);
				return { key, views: views.get(key) || 0, sessions: sessions.get(key) || 0 };
			});

			const width = 960;
			const left = 42;
			const right = 16;
			const top = 24;
			const bottom = 230;
			const step = points.length > 1 ? (width - left - right) / (points.length - 1) : 0;
			const maxValue = Math.max(1, ...points.flatMap((point) => [point.views, point.sessions]));
			const chartMax = Math.max(4, Math.ceil(maxValue / 4) * 4);
			const makeCoordinates = (key) => points.map((point, index) => ({
				x: left + step * index,
				y: bottom - (point[key] / chartMax) * (bottom - top),
			}));
			const makePath = (coordinates) => {
				if (!coordinates.length) return "";
				if (coordinates.length === 1) {
					const point = coordinates[0];
					return `M ${point.x.toFixed(2)} ${point.y.toFixed(2)}`;
				}

				const tension = 1.05;
				const clampToChart = (value) => Math.max(top, Math.min(bottom, value));
				let path = `M ${coordinates[0].x.toFixed(2)} ${coordinates[0].y.toFixed(2)}`;

				for (let index = 0; index < coordinates.length - 1; index += 1) {
					const start = coordinates[index];
					const end = coordinates[index + 1];
					const previous = coordinates[Math.max(0, index - 1)];
					const next = coordinates[Math.min(coordinates.length - 1, index + 2)];
					const controlStart = {
						x: start.x + ((end.x - previous.x) * tension) / 6,
						y: clampToChart(start.y + ((end.y - previous.y) * tension) / 6),
					};
					const controlEnd = {
						x: end.x - ((next.x - start.x) * tension) / 6,
						y: clampToChart(end.y - ((next.y - start.y) * tension) / 6),
					};
					path += ` C ${controlStart.x.toFixed(2)} ${controlStart.y.toFixed(2)}, ${controlEnd.x.toFixed(2)} ${controlEnd.y.toFixed(2)}, ${end.x.toFixed(2)} ${end.y.toFixed(2)}`;
				}

				return path;
			};
			const viewCoordinates = makeCoordinates("views");
			const sessionCoordinates = makeCoordinates("sessions");
			const viewPath = makePath(viewCoordinates);
			const sessionPath = makePath(sessionCoordinates);
			viewLine.setAttribute("d", viewPath);
			sessionLine.setAttribute("d", sessionPath);
			area.setAttribute("d", `${viewPath} L ${viewCoordinates.at(-1).x.toFixed(2)} ${bottom} L ${viewCoordinates[0].x.toFixed(2)} ${bottom} Z`);
			pointLayer.innerHTML = viewCoordinates.map((point, index) => `<circle class="analytics-chart__point" data-chart-index="${index}" cx="${point.x.toFixed(2)}" cy="${point.y.toFixed(2)}" r="${points.length > 45 ? "2.4" : "3.2"}"></circle>`).join("");
			if (endpointLayer) {
				const endpoints = [
					{ point: viewCoordinates[0], type: "views", edge: "start" },
					{ point: viewCoordinates.at(-1), type: "views", edge: "end" },
					{ point: sessionCoordinates.at(-1), type: "sessions", edge: "end" },
				];
				endpointLayer.innerHTML = endpoints
					.filter(({ point }) => point)
					.map(({ point, type, edge }) => `<circle class="analytics-chart__endpoint analytics-chart__endpoint--${type} analytics-chart__endpoint--${edge}" cx="${point.x.toFixed(2)}" cy="${point.y.toFixed(2)}" r="${type === "views" ? "3.6" : "2.8"}"></circle>`)
					.join("");
			}

			root.querySelector('[data-chart-y-label="max"]').textContent = formatNumber(chartMax);
			root.querySelector('[data-chart-y-label="mid"]').textContent = formatNumber(Math.round(chartMax / 2));
			root.querySelector('[data-chart-y-label="min"]').textContent = "0";
			root.querySelector('[data-chart-x-label="start"]').textContent = dateLabel(points[0].key);
			root.querySelector('[data-chart-x-label="middle"]').textContent = dateLabel(points[Math.floor((points.length - 1) / 2)].key);
			root.querySelector('[data-chart-x-label="end"]').textContent = dateLabel(points.at(-1).key);

			const total = points.reduce((sum, point) => sum + point.views, 0);
			const peak = Math.max(...points.map((point) => point.views), 0);
			const activeDays = points.filter((point) => point.views > 0).length;
			const chartTotal = root.querySelector("[data-chart-total]");
			const chartPeak = root.querySelector("[data-chart-peak]");
			const chartActive = root.querySelector("[data-chart-active]");
			if (chartTotal) chartTotal.textContent = formatNumber(total);
