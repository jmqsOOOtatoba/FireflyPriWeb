			};
			const onPointerMove = (event) => {
				// SVG 在容器中可能留白，按实际渲染矩阵换算鼠标位置。
				const screenMatrix = chart.getScreenCTM();
				if (!screenMatrix) return;
				const svgPoint = new DOMPoint(event.clientX, event.clientY).matrixTransform(screenMatrix.inverse());
				updateTooltip(Math.round((svgPoint.x - left) / step));
			};
			const onPointerLeave = () => {
				if (tooltip) tooltip.hidden = true;
				if (guide) guide.style.display = "none";
			};
			chart.addEventListener("pointermove", onPointerMove);
			chart.addEventListener("pointerleave", onPointerLeave);
