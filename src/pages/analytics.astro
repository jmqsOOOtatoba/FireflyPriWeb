			if (previousFrame) cancelAnimationFrame(previousFrame);
			const animationClock = getAnimationClock();
			const startedAt = animationClock.start();
			const applyFrame = (progress) => {
				const eased = easeCountProgress(progress);
				const totalElement = card.querySelector("[data-source-total]");
				if (totalElement) totalElement.textContent = formatNumber(total * eased);
				card.querySelectorAll("[data-source-target-percent]").forEach((item) => {
					const target = Number(item.dataset.sourceTargetPercent) || 0;
					const value = item.querySelector("b");
					if (value) value.textContent = `${Math.round(target * eased)}%`;
				});
				const svg = card.querySelector("[data-source-donut] svg");
				if (svg) svg.style.setProperty("--source-donut-progress", `${(eased * 360).toFixed(2)}deg`);
