		const footerAnimationFrames = new WeakMap();
		const animateAnalyticsFooter = (root) => {
			const footer = root.querySelector("[data-analytics-footer]");
			if (!footer) return;
			const previousFrame = footerAnimationFrames.get(footer);
			if (previousFrame) cancelAnimationFrame(previousFrame);
			const link = footer.querySelector(".analytics-footer__link");
			const animationClock = getAnimationClock();
			const startedAt = animationClock.start();
			const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
			const clamp = (value) => Math.max(0, Math.min(1, value));
			const setProgress = (progress) => {
				const sheenProgress = clamp((progress - 0.08) / 0.64);
				const sheen = Math.sin(sheenProgress * Math.PI);
				const linkSettle = easeCountProgress(clamp((progress - 0.5) / 0.3));
				footer.style.setProperty("--footer-sheen-opacity", (sheen * 0.42).toFixed(3));
				footer.style.setProperty("--footer-sheen-offset", `${((sheenProgress * 2 - 1) * 145).toFixed(2)}%`);
				link?.style.setProperty("--footer-link-offset", `${((1 - linkSettle) * 0.12).toFixed(3)}rem`);
				footer.dataset.footerAnimationPhase = progress < 0.5 ? "revealing" : progress < 0.8 ? "settling" : "complete";
			};
			const finish = () => {
				footer.style.setProperty("--footer-sheen-opacity", "0");
				footer.style.setProperty("--footer-sheen-offset", "145%");
				link?.style.setProperty("--footer-link-offset", "0rem");
				footer.dataset.footerAnimationPhase = "complete";
				footerAnimationFrames.delete(footer);
			};

			if (reducedMotion) {
				finish();
				return;
			}

			footer.dataset.footerAnimationPhase = "revealing";
			const tick = (timestamp) => {
				const progress = clamp((timestamp - startedAt) / animationClock.duration);
				setProgress(progress);
				if (progress < 1) {
					const frame = requestAnimationFrame(tick);
					footerAnimationFrames.set(footer, frame);
					return;
				}
				finish();
			};
			footerAnimationFrames.set(footer, requestAnimationFrame(tick));
		};
		const setupAnalyticsFooter = (root) => {
