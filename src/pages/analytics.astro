		const setupVisitorActivity = (root, apiBase, shareId) => {
			const card = root.querySelector("[data-visitor-activity]");
			const grid = card?.querySelector("[data-activity-grid]");
			if (!card || !grid) return () => {};

			const cells = [...grid.querySelectorAll("[data-activity-cell]")];
			const note = card.querySelector("[data-activity-note]");
			const statElements = {
				time: card.querySelector('[data-activity-stat="time"]'),
				day: card.querySelector('[data-activity-stat="day"]'),
				night: card.querySelector('[data-activity-stat="night"]'),
			};
			const weekdayLabels = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"];
			const controller = new AbortController();
			let activeValues = [];
			let activityAnimationFrame;
			const setText = (element, value) => {
				if (element) element.textContent = value;
			};
			const animateActivity = () => {
				if (activityAnimationFrame) cancelAnimationFrame(activityAnimationFrame);
				const activeCells = cells.filter((cell) => Number(cell.dataset.activityTargetLevel) > 0);
				if (!activeCells.length) return;
				const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
				if (reducedMotion) {
					activeCells.forEach((cell) => { cell.dataset.level = cell.dataset.activityTargetLevel; });
					return;
				}
				activeCells.forEach((cell) => { cell.dataset.level = "0"; });
				const animationClock = getAnimationClock();
				const clockStart = animationClock.start();
				const startedAt = performance.now() - clockStart >= animationClock.duration ? performance.now() : clockStart;
				const tick = (timestamp) => {
					const progress = Math.min(1, Math.max(0, (timestamp - startedAt) / animationClock.duration));
					activeCells.forEach((cell) => {
						if (cell.dataset.level !== "0") return;
						const hour = Number(cell.dataset.hour);
						const weekday = Number(cell.dataset.weekday);
						if (progress >= 0.08 + 0.74 * (hour / 23) + 0.1 * (weekday / 6)) {
							cell.dataset.level = cell.dataset.activityTargetLevel;
						}
					});
					if (progress < 1) activityAnimationFrame = requestAnimationFrame(tick);
				};
				activityAnimationFrame = requestAnimationFrame(tick);
			};

			const getActivityParts = (value) => {
				const match = /^(\d{4})-(\d{2})-(\d{2})[ T](\d{2})/u.exec(String(value ?? ""));
				if (!match) return null;
				const hour = Number.parseInt(match[4], 10);
				const weekday = (new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3]))).getUTCDay() + 6) % 7;
				return Number.isInteger(weekday) && Number.isInteger(hour) ? { weekday, hour } : null;
			};

			const renderActivity = (rows, statusText) => {
				const matrix = Array.from({ length: 7 }, () => Array.from({ length: 24 }, () => 0));
				for (const row of rows) {
					const parsed = getActivityParts(row?.x ?? row?.t);
					const value = Math.max(0, Number(row?.y) || 0);
					if (!parsed || value <= 0) continue;
					matrix[parsed.weekday][parsed.hour] += value;
				}

				activeValues = matrix.flat();
				const maxValue = Math.max(0, ...activeValues);
				const totalValue = activeValues.reduce((sum, value) => sum + value, 0);
				const maxCellIndex = activeValues.indexOf(maxValue);
				const maxHour = maxCellIndex >= 0 ? maxCellIndex % 24 : -1;
				const dayTotals = matrix.map((day) => day.reduce((sum, value) => sum + value, 0));
				const peakDay = dayTotals.indexOf(Math.max(0, ...dayTotals));
				const nightValue = matrix.flatMap((day) => day.filter((_, hour) => hour >= 22 || hour <= 5)).reduce((sum, value) => sum + value, 0);
				cells.forEach((cell) => {
					const weekday = Number(cell.dataset.weekday);
					const hour = Number(cell.dataset.hour);
					const value = matrix[weekday]?.[hour] || 0;
					const ratio = maxValue ? value / maxValue : 0;
					const level = value > 0 ? Math.max(1, Math.ceil(ratio * 5)) : 0;
					cell.dataset.activityTargetLevel = String(level);
					cell.dataset.level = String(level);
					cell.dataset.activityValue = String(value);
					cell.setAttribute("aria-label", `${weekdayLabels[weekday]} ${String(hour).padStart(2, "0")}:00 · ${formatNumber(value)} 次访问`);
					cell.title = cell.getAttribute("aria-label");
				});

				setText(statElements.time, maxHour >= 0 && maxValue > 0 ? `${String(maxHour).padStart(2, "0")}:00` : "—");
				setText(statElements.day, peakDay >= 0 && dayTotals[peakDay] > 0 ? weekdayLabels[peakDay] : "—");
				setText(statElements.night, totalValue > 0 ? `${Math.round((nightValue / totalValue) * 100)}%` : "—");
				if (note) note.textContent = statusText;
				animateActivity();
			};

			const resetDetail = () => {
				if (note) note.textContent = "按北京时间聚合近 30 天访问记录 · 鼠标移入查看具体时段";
			};
			cells.forEach((cell) => {
				const showDetail = () => {
					const value = Number(cell.dataset.activityValue) || 0;
					const weekday = Number(cell.dataset.weekday);
					const hour = Number(cell.dataset.hour);
					if (note) note.textContent = `${weekdayLabels[weekday]} ${String(hour).padStart(2, "0")}:00 · ${formatNumber(value)} 次访问`;
				};
				cell.addEventListener("pointerenter", showDetail);
				cell.addEventListener("focus", showDetail);
				cell.addEventListener("pointerleave", resetDetail);
				cell.addEventListener("blur", resetDetail);
			});

			const load = async () => {
				if (!apiBase || !shareId) {
					renderActivity([], "尚未配置公开分享数据");
					return;
				}
				try {
					const share = await fetchShare(apiBase, shareId, controller.signal);
					const endAt = Date.now();
					const startAt = endAt - 30 * 24 * 60 * 60 * 1000;
					// Umami silently degrades unit=hour to day when the range exceeds 48h, so cover 30 days with 48h slices.
					const sliceMs = 48 * 60 * 60 * 1000;
					const slices = Array.from({ length: 15 }, (_, index) => {
						const sliceStart = startAt + index * sliceMs;
						return [sliceStart, Math.min(endAt, sliceStart + sliceMs)];
					});
					const headers = {
						"x-umami-share-token": share.token,
						"x-umami-share-context": "1",
					};
					const results = await Promise.allSettled(
						slices.map(([sliceStart, sliceEnd]) => {
							const url = new URL(`${apiBase}/api/websites/${share.websiteId}/pageviews`);
							url.searchParams.set("startAt", String(sliceStart));
							url.searchParams.set("endAt", String(sliceEnd));
							url.searchParams.set("unit", "hour");
							url.searchParams.set("timezone", timeZone);
							return fetchJson(url, { headers, signal: controller.signal }, 7000);
						}),
					);
					const fulfilled = results.filter((result) => result.status === "fulfilled");
					if (!fulfilled.length) {
						const aborted = results.some((result) => result.status === "rejected" && result.reason?.name === "AbortError");
						if (aborted) return;
						renderActivity([], "小时级公开数据暂时不可用 · 可稍后刷新");
						return;
					}
					const sessions = fulfilled.flatMap((result) => readRows(result.value?.sessions));
					const pageviews = fulfilled.flatMap((result) => readRows(result.value?.pageviews));
					renderActivity(sessions.length ? sessions : pageviews, sessions.length ? "按北京时间聚合近 30 天访客记录 · 鼠标移入查看具体时段" : "按北京时间聚合近 30 天访问记录 · 鼠标移入查看具体时段");
				} catch (error) {
					if (error?.name === "AbortError") return;
					renderActivity([], "小时级公开数据暂时不可用 · 可稍后刷新");
				}
			};

			const handleAnimationReplay = () => animateActivity();
			window.addEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
			load();
			return () => {
				controller.abort();
				if (activityAnimationFrame) cancelAnimationFrame(activityAnimationFrame);
				window.removeEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
				cells.forEach((cell) => {
					cell.replaceWith(cell.cloneNode(true));
				});
			};
		};

		// —— 最近评论：Twikoo GET_RECENT_COMMENTS（浏览器公开可调）——
		const recentCommentsAnimationFrames = new WeakMap();
		const animateRecentComments = (root) => {
			const list = root.querySelector("[data-comments-list]");
			if (!list) return;
			const items = [...list.querySelectorAll(".analytics-comment:not(.analytics-comment--skeleton)")];
			if (!items.length) return;
			const previousFrame = recentCommentsAnimationFrames.get(list);
			if (previousFrame) cancelAnimationFrame(previousFrame);

			const animationClock = getAnimationClock();
			const startedAt = animationClock.start();
			const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
			const generationEnd = 0.42;
			const rhythmEnd = 0.82;
			const clamp01 = (value) => Math.max(0, Math.min(1, value));
			const setItemProgress = (item, progress, index) => {
				const rowStart = (index / Math.max(items.length, 1)) * 0.58;
				const rowProgress = clamp01((progress - rowStart) / 0.28);
				const eased = easeCountProgress(rowProgress);
				item.style.setProperty("--comment-opacity", eased.toFixed(3));
				item.style.setProperty("--comment-offset", `${((1 - eased) * 0.72).toFixed(3)}rem`);
				item.style.setProperty("--comment-scale", (0.98 + eased * 0.02).toFixed(3));
				item.dataset.commentsAnimationState = rowProgress >= 1 ? "visible" : "pending";
			};
			const finish = () => {
				items.forEach((item) => {
					item.style.setProperty("--comment-opacity", "1");
					item.style.setProperty("--comment-offset", "0rem");
					item.style.setProperty("--comment-scale", "1");
					item.style.setProperty("--comment-ring", "0");
					item.dataset.commentsAnimationState = "visible";
				});
				list.dataset.commentsAnimationPhase = "complete";
				recentCommentsAnimationFrames.delete(list);
			};
			if (reducedMotion) {
				finish();
				return;
			}
			items.forEach((item) => {
				item.style.setProperty("--comment-opacity", "0");
				item.style.setProperty("--comment-offset", "0.72rem");
				item.style.setProperty("--comment-scale", "0.98");
				item.style.setProperty("--comment-ring", "0");
				item.dataset.commentsAnimationState = "pending";
			});
			const tick = (timestamp) => {
				const progress = clamp01((timestamp - startedAt) / animationClock.duration);
				items.forEach((item, index) => setItemProgress(item, progress, index));
				const rhythmProgress = easeCountProgress(clamp01((progress - generationEnd) / (rhythmEnd - generationEnd)));
				const pulse = progress >= generationEnd && progress < rhythmEnd ? Math.sin(rhythmProgress * Math.PI) : 0;
				items[0]?.style.setProperty("--comment-ring", (pulse * 0.9).toFixed(3));
				if (progress < 1) {
					const frame = requestAnimationFrame(tick);
					recentCommentsAnimationFrames.set(list, frame);
					return;
				}
				finish();
			};
			recentCommentsAnimationFrames.set(list, requestAnimationFrame(tick));
		};

		const showCommentsMessage = (root, title, description) => {
