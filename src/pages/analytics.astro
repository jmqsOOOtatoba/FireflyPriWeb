			const currentWeekCount = weekCounts.get(currentWeekKey) || 0;
			const currentCumulativeCount = [...weekCounts.entries()]
				.filter(([key]) => key <= currentWeekKey)
				.reduce((sum, [, count]) => sum + count, 0);
