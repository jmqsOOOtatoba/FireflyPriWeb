				if (reducedMotion) {
					finishChartAnimation();
					return;
				}
				const animationClock = getAnimationClock();
				if (isInitialRender && animationClock.startedAt !== null) animationClock.replay();
				const startedAt = animationClock.start();
				const tick = (timestamp) => {
					const progress = Math.min(1, (timestamp - startedAt) / animationClock.duration);
					const eased = easeCountProgress(progress);
					animatedPaths.forEach((path) => {
						path.style.clipPath = `inset(0 ${(100 - eased * 100).toFixed(2)}% 0 0)`;
					});
					area.style.opacity = String(eased);
					if (progress < 1) {
						chartAnimationFrame = requestAnimationFrame(tick);
						return;
					}
					finishChartAnimation();
				};
				chartAnimationFrame = requestAnimationFrame(tick);
			};
