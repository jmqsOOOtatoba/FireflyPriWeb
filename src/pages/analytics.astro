					const image = document.createElement("img");
					image.src = avatarUrl;
					image.alt = `${nick} 的头像`;
					image.loading = "lazy";
					image.decoding = "async";
					image.referrerPolicy = "no-referrer";
					image.addEventListener("error", () => avatar.replaceChildren(initial), { once: true });
					avatar.replaceChildren(image);
				}

				const body = document.createElement("div");
				body.className = "analytics-comment__body";
				const topline = document.createElement("div");
				topline.className = "analytics-comment__topline";
				const identity = document.createElement("div");
				identity.className = "analytics-comment__identity";
				const name = document.createElement("strong");
				name.textContent = nick;
				const time = document.createElement("time");
				time.textContent = formatCommentTime(insertedAt);
				if (insertedAt) time.dateTime = String(insertedAt);
				identity.append(name, time);

				const pageLabel = document.createElement("span");
				pageLabel.className = "analytics-comment__page";
				pageLabel.textContent = `评论于 ${page.label}`;
				topline.append(identity, pageLabel);

				const content = document.createElement("p");
				content.className = "analytics-comment__text";
				content.textContent = text;
				body.append(topline, content);
				link.append(avatar, body);
				item.append(link);
				return item;
			});

			list.replaceChildren(...items);
			list.dataset.commentsState = "ready";
			animateRecentComments(root);
			if (status) status.textContent = `已展示 ${comments.length} 条公开评论 · 内容来自 Twikoo`;
		};

		const setupRecentComments = (root) => {
			const panel = root.querySelector("[data-recent-comments]");
			const status = root.querySelector("[data-comments-status]");
			if (!panel) return () => {};
			const serverURL = String(panel.dataset.commentServer || "").replace(/\/+$/u, "");
			if (!serverURL) {
				showCommentsMessage(root, "评论系统尚未配置", "在 commentConfig.ts 启用 Twikoo 后，这里会自动显示最新评论。");
				if (status) status.textContent = "Twikoo 未启用";
				return () => {};
			}

			const controller = new AbortController();
			const load = async () => {
				try {
					const response = await fetch(serverURL, {
						method: "POST",
						headers: { "Content-Type": "application/json", Accept: "application/json" },
						body: JSON.stringify({ event: "GET_RECENT_COMMENTS", includeAudit: false, pageSize: 8, sort: "" }),
						signal: controller.signal,
					});
					if (!response.ok) throw new Error(`twikoo ${response.status}`);
					const payload = await response.json();
					if (payload && payload.code && payload.code !== 0) throw new Error(payload.errmsg || "twikoo comments unavailable");
					renderRecentComments(root, payload);
				} catch (error) {
					if (error?.name === "AbortError") return;
					showCommentsMessage(root, "最近评论暂时不可用", "可以稍后重试，或直接打开留言板查看完整讨论。");
					if (status) status.textContent = "Twikoo 公共接口暂时没有响应";
				}
			};
			const handleAnimationReplay = () => {
				if (root.querySelector("[data-comments-list]")?.dataset.commentsState === "ready") animateRecentComments(root);
			};
			window.addEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
			load();
			return () => {
				controller.abort();
				window.removeEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
				const list = root.querySelector("[data-comments-list]");
				const frame = list && recentCommentsAnimationFrames.get(list);
				if (frame) cancelAnimationFrame(frame);
				if (list) recentCommentsAnimationFrames.delete(list);
			};
		};

		const setup = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			if (!root) {
				clearRuntime();
				return;
			}
			if (runtime.activeRoot === root) return;
			clearRuntime();
			runtime.activeRoot = root;

			const apiBase = String(root.dataset.apiBase || "").replace(/\/+$/, "");
			const shareId = root.dataset.shareId || "";
			const rangeButtons = [...root.querySelectorAll("[data-range]")];
			const refreshButton = root.querySelector("[data-analytics-refresh]");
			const cleanups = [];
			let range = 30;
			let controller;
			let refreshInFlight = false;
			let chartCleanup;
			runtime.cleanup = () => {
				controller?.abort();
				chartCleanup?.();
				for (const cleanup of cleanups.splice(0)) cleanup();
				runtime.activeRoot = null;
			};

			const localHost = ["localhost", "127.0.0.1", "::1", "0.0.0.0"].includes(window.location.hostname.toLowerCase());
			const isLocal = localHost || window.location.protocol === "file:" || document.documentElement.dataset.analyticsMode === "local";
			cleanups.push(setupAnalyticsFooter(root));
			cleanups.push(setupPushRhythm(root));
			cleanups.push(setupSummaryCards(root, apiBase, shareId));
			cleanups.push(setupRecentComments(root));
			root.classList.toggle("is-local-preview", isLocal);
			if (!hasPublicStats || !apiBase || !shareId) {
				setStatus(root, "offline", "未配置");
				const lastUpdate = root.querySelector("[data-analytics-last-update]");
				if (lastUpdate) lastUpdate.textContent = "尚未配置公开分享数据";
				renderTrafficSources(root, [], range);
				cleanups.push(setupVisitorActivity(root, apiBase, shareId));
				return;
			}
			cleanups.push(setupVisitorActivity(root, apiBase, shareId));

			const updateRangeButtons = () => rangeButtons.forEach((button) => button.setAttribute("aria-pressed", String(Number(button.dataset.range) === range)));
			const refresh = async (forceRefresh = false) => {
				if (refreshInFlight) return;
				refreshInFlight = true;
				chartCleanup?.(!forceRefresh);
				chartCleanup = undefined;
				controller?.abort();
				controller = new AbortController();
				root.classList.add("is-loading");
				setStatus(root, "loading", "读取中");
				if (refreshButton) refreshButton.disabled = true;
				const endAt = Date.now();
				const startAt = endAt - range * 24 * 60 * 60 * 1000;
				const cacheKey = getCacheKey(shareId, range);
				try {
					const cached = forceRefresh ? null : readCache(cacheKey);
					let requests;
					if (cached) {
						requests = {
							traffic: Promise.resolve(cached.pageviews),
							ranking: Promise.resolve(cached.paths),
						};
						if (cached.sources !== undefined) requests.sources = Promise.resolve(cached.sources);
					} else {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
						const buildUrl = (path, params = {}) => {
							const url = new URL(`${apiBase}/api/websites/${share.websiteId}/${path}`);
							url.searchParams.set("startAt", String(startAt));
							url.searchParams.set("endAt", String(endAt));
							Object.entries(params).forEach(([key, value]) => url.searchParams.set(key, String(value)));
							return url;
						};
						requests = {
							traffic: fetchJson(buildUrl("pageviews", { unit: "day", timezone: timeZone }), { headers, signal: controller.signal }),
							ranking: fetchJson(buildUrl("metrics", { type: "url", limit: 20 }), { headers, signal: controller.signal }),
							sources: fetchJson(buildUrl("metrics", { type: "channel", limit: 500 }), { headers, signal: controller.signal }),
						};
					}
					if (!requests.sources) {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
						const url = new URL(`${apiBase}/api/websites/${share.websiteId}/metrics`);
						url.searchParams.set("startAt", String(startAt));
						url.searchParams.set("endAt", String(endAt));
						url.searchParams.set("type", "channel");
						url.searchParams.set("limit", "500");
						requests.sources = fetchJson(url, { headers, signal: controller.signal });
					}

					const sections = [
						{
							key: "traffic",
							request: requests.traffic,
							render: (payload) => {
								const pageviews = readRows(payload?.pageviews);
								const sessions = readRows(payload?.sessions);
								chartCleanup?.();
								chartCleanup = drawChart(root, pageviews, sessions, range);
							},
							fallback: () => showChartMessage(root, "趋势暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "ranking",
							request: requests.ranking,
							render: (payload) => renderRanking(root, readRows(payload)),
							fallback: () => showRankingMessage(root, "热门页面暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "sources",
							request: requests.sources,
							render: (payload) => renderTrafficSources(root, readRows(payload), range),
							fallback: () => renderTrafficSources(root, [], range),
						},
					];
					const successful = new Set();
					const failed = new Set();
					const updateProgress = () => {
						const lastUpdate = root.querySelector("[data-analytics-last-update]");
						if (successful.size > 0 && failed.size === 0 && successful.size === sections.length) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 已更新" : "在线");
							if (lastUpdate) lastUpdate.textContent = `${isLocal ? "本地预览刚刚更新" : "刚刚更新"} · ${range} 天区间`;
						} else if (successful.size > 0) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 部分更新" : "部分在线");
							if (lastUpdate) lastUpdate.textContent = `已更新 ${successful.size}/${sections.length} 个模块`;
						}
					};
					const settleSection = async (section) => {
						try {
							return { status: "fulfilled", payload: await section.request };
						} catch (error) {
							return { status: "rejected", error };
						}
					};
					const applySectionResult = (section, result) => {
						if (result.status === "fulfilled") {
							section.render(result.payload);
							successful.add(section.key);
						} else {
							if (result.error?.name === "AbortError") return;
							failed.add(section.key);
							section.fallback();
						}
						updateProgress();
					};

					if (forceRefresh) {
						const results = await Promise.all(sections.map(settleSection));
						if (results.some((result) => result.status === "fulfilled" || result.error?.name !== "AbortError")) {
							replayAnalyticsAnimations();
							results.forEach((result, index) => applySectionResult(sections[index], result));
						}
					} else {
						await Promise.all(sections.map(async (section) => {
							applySectionResult(section, await settleSection(section));
						}));
					}

					if (!cached && successful.size === sections.length) {
						writeCache(cacheKey, {
							pageviews: await requests.traffic,
							paths: await requests.ranking,
							sources: await requests.sources,
						});
					}
					if (successful.size === 0 && failed.size > 0) {
						setStatus(root, "offline", "暂不可用");
						const lastUpdate = root.querySelector("[data-analytics-last-update]");
						if (lastUpdate) lastUpdate.textContent = "公开接口暂时没有响应 · 可稍后重试";
						renderTrafficSources(root, [], range);
					}
				} catch (error) {
					if (error?.name !== "AbortError") {
						setStatus(root, "offline", "暂不可用");
						const lastUpdate = root.querySelector("[data-analytics-last-update]");
						if (lastUpdate) lastUpdate.textContent = "公开接口暂时没有响应 · 可稍后重试";
						showUnavailableSections(root, "公开数据接口响应较慢，请稍后刷新重试。");
						renderTrafficSources(root, [], range);
					}
				} finally {
					refreshInFlight = false;
					root.classList.remove("is-loading");
					if (refreshButton) refreshButton.disabled = false;
				}
			};

			for (const button of rangeButtons) {
				const onClick = () => {
					range = Number(button.dataset.range) || 30;
					updateRangeButtons();
					refresh();
				};
				button.addEventListener("click", onClick);
				cleanups.push(() => button.removeEventListener("click", onClick));
			}
			if (refreshButton) {
				const onRefresh = () => refresh(true);
				refreshButton.addEventListener("click", onRefresh);
				cleanups.push(() => refreshButton.removeEventListener("click", onRefresh));
			}
			updateRangeButtons();
			refresh();
		};

		if (!runtime.bound) {
			for (const eventName of ["astro:page-load", "astro:after-swap", "swup:contentReplaced", "swup:page:view"]) {
				document.addEventListener(eventName, setup);
			}
			runtime.bound = true;
		}
		window[runtimeKey] = runtime;
		setup();
	})();
</script>

<script is:inline define:vars={{ shareId, shareApiBase }}>
	(() => {
		const runtimeKey = "__rainztAnalyticsSnapshotRuntime";
		const runtime = window[runtimeKey] || { inFlight: false, initialized: false };
		window[runtimeKey] = runtime;
		const dayMs = 24 * 60 * 60 * 1000;
		const rangeDays = 30;
		const apiBase = String(shareApiBase || "").replace(/\/+$/, "");
		const localHosts = new Set(["localhost", "127.0.0.1", "::1", "0.0.0.0"]);
		const formatNumber = (value) => new Intl.NumberFormat("zh-CN").format(Math.max(0, Math.round(Number(value) || 0)));
		const visualDuration = 4500;
		const snapshotAnimationFrames = new WeakMap();
		const snapshotAnimationPending = new WeakMap();
		const snapshotOverlayTimers = new WeakMap();
		const animationClockKey = "__rainztAnalyticsAnimationClock";
		let snapshotVisibilityObserver;
		const easeCountProgress = (progress) => progress < 0.18
			? 0.08 * Math.pow(progress / 0.18, 2)
			: progress < 0.9
				? 0.08 + 0.82 * ((progress - 0.18) / 0.72)
				: 0.9 + 0.1 * (1 - Math.pow(1 - ((progress - 0.9) / 0.1), 3));
		const getAnimationClock = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			const current = window[animationClockKey];
			if (current?.root === root) return current;
			const clock = {
				root,
				duration: visualDuration,
				startedAt: null,
				start() {
					if (this.startedAt === null) this.startedAt = performance.now();
					return this.startedAt;
				},
				replay() {
					this.startedAt = null;
					window.dispatchEvent(new CustomEvent("rainzt-analytics-animation-replay"));
				},
			};
			window[animationClockKey] = clock;
			return clock;
		};
		const getRoots = () => [...document.querySelectorAll("[data-analytics-snapshot]")];
		const getPeriodRoots = () => [...document.querySelectorAll("[data-analytics-period]")];
		const readRows = (value) => (Array.isArray(value) ? value : value?.data || []);
		const isLocalPreview = () => localHosts.has(window.location.hostname.toLowerCase()) || window.location.protocol === "file:";

		const setText = (root, selector, value) => {
			root.querySelectorAll(selector).forEach((element) => {
				element.textContent = value;
			});
		};

		const fetchJson = async (url, options = {}, timeoutMs = 7000) => {
			const controller = new AbortController();
			const timer = window.setTimeout(() => controller.abort(), timeoutMs);
			try {
				const response = await fetch(url, { cache: "no-store", ...options, signal: controller.signal });
				if (!response.ok) throw new Error(`umami ${response.status}`);
				return await response.json();
			} finally {
				window.clearTimeout(timer);
			}
		};

		const readCache = (key, ttl) => {
			try {
				const cached = JSON.parse(localStorage.getItem(key) || "null");
				return cached?.timestamp && Date.now() - cached.timestamp < ttl ? cached.value : null;
			} catch {
				return null;
			}
		};

		const writeCache = (key, value) => {
			try {
				localStorage.setItem(key, JSON.stringify({ timestamp: Date.now(), value }));
			} catch {
				// 无痕模式或禁用本地存储时，继续使用本次请求的数据。
			}
		};

		const fetchShare = async () => {
			const cached = readCache(`rainzt:umami:share:${shareId}`, dayMs);
			if (cached?.websiteId && cached?.token) return cached;
			let lastError;
			for (const path of [`/api/share/${encodeURIComponent(shareId)}`, `/api/share/id/${encodeURIComponent(shareId)}`]) {
				try {
					const share = await fetchJson(`${apiBase}${path}`);
					if (share?.websiteId && share?.token) {
						writeCache(`rainzt:umami:share:${shareId}`, share);
						return share;
					}
				} catch (error) {
					lastError = error;
				}
			}
			throw lastError || new Error("public share unavailable");
		};

		const showStatus = (root, state, text) => {
			const status = root.querySelector("[data-snapshot-status]");
			if (status) status.dataset.state = state;
			setText(root, "[data-snapshot-status-text]", text);
		};

		const showMessage = (root, message) => {
			root.querySelectorAll("[data-snapshot-breakdown]").forEach((container) => {
				const donut = container.querySelector("[data-snapshot-donut]");
				const svg = container.querySelector("[data-snapshot-donut-svg]");
				const legend = container.querySelector("[data-snapshot-legend]");
				svg?.replaceChildren();
				donut?.classList.add("is-empty");
				if (!legend) return;
				const text = document.createElement("p");
				text.className = "analytics-snapshot__message";
				text.textContent = message;
				legend.replaceChildren(text);
			});
		};

		const isVisible = (element) => {
			const rect = element.getBoundingClientRect();
			return rect.bottom > 0 && rect.top < window.innerHeight;
		};

		const applySnapshotAnimationFrame = (root, values, progress) => {
			const eased = easeCountProgress(progress);
			setText(root, '[data-snapshot-stat="pageviews"]', formatNumber(values.pageviews * eased));
			setText(root, '[data-snapshot-stat="visitors"]', formatNumber(values.visitors * eased));
			setText(root, '[data-snapshot-stat="activeDays"]', `${Math.round(values.activeDays * eased)}/${rangeDays}`);
			setText(root, '[data-snapshot-stat="peak"]', formatNumber(values.peak * eased));
			root.querySelectorAll("[data-snapshot-change-target]").forEach((element) => {
				const target = Number(element.dataset.snapshotChangeTarget) || 0;
				const sign = element.dataset.snapshotChangeSign || "↑";
				element.textContent = `${sign} ${Math.round(target * eased)}% 较上周期`;
			});
			root.querySelectorAll("[data-snapshot-legend-index]").forEach((item) => {
				const target = Number(item.dataset.snapshotTargetPercent) || 0;
				const value = item.querySelector("strong");
				if (value) value.textContent = `${Math.round(target * eased)}%`;
			});
			root.querySelectorAll("[data-snapshot-donut-svg]").forEach((svg) => {
				svg.style.setProperty("--snapshot-donut-progress", `${(eased * 360).toFixed(2)}deg`);
			});
		};

		const startSnapshotAnimation = (root, values) => {
			const previousFrame = snapshotAnimationFrames.get(root);
			if (previousFrame) cancelAnimationFrame(previousFrame);
			const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
			if (reducedMotion) {
				applySnapshotAnimationFrame(root, values, 1);
				return;
			}
			const animationClock = getAnimationClock();
			const startedAt = animationClock.start();
			const tick = (timestamp) => {
				const progress = Math.min(1, (timestamp - startedAt) / animationClock.duration);
				applySnapshotAnimationFrame(root, values, progress);
				if (progress < 1) {
					const frame = requestAnimationFrame(tick);
					snapshotAnimationFrames.set(root, frame);
					return;
				}
				applySnapshotAnimationFrame(root, values, 1);
				snapshotAnimationFrames.delete(root);
			};
			const frame = requestAnimationFrame(tick);
			snapshotAnimationFrames.set(root, frame);
		};

		const queueSnapshotAnimation = (root, values) => {
			snapshotAnimationPending.set(root, values);
			if (isVisible(root)) {
				startSnapshotAnimation(root, values);
				return;
			}
			if (!("IntersectionObserver" in window)) {
				// 无观察器能力时直接给终值，不做滚动动画
				applySnapshotAnimationFrame(root, values, 1);
				return;
			}
			if (!snapshotVisibilityObserver) {
				snapshotVisibilityObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const pending = snapshotAnimationPending.get(entry.target);
						if (pending) startSnapshotAnimation(entry.target, pending);
						snapshotVisibilityObserver.unobserve(entry.target);
					});
				}, { threshold: 0.18 });
			}
			snapshotVisibilityObserver.observe(root);
		};
		if (!runtime.replayBound) {
			window.addEventListener("rainzt-analytics-animation-replay", () => {
				[...getRoots(), ...getPeriodRoots()].forEach((root) => {
					const values = snapshotAnimationPending.get(root);
					if (values) queueSnapshotAnimation(root, values);
				});
			});
			runtime.replayBound = true;
		}

		const polarPoint = (radius, angle) => {
			const radians = ((angle - 90) * Math.PI) / 180;
			return [50 + radius * Math.cos(radians), 50 + radius * Math.sin(radians)];
		};

		const describeDonutSlice = (startAngle, endAngle) => {
			const outerStart = polarPoint(46, startAngle);
			const outerEnd = polarPoint(46, endAngle);
			const innerStart = polarPoint(25, startAngle);
			const innerEnd = polarPoint(25, endAngle);
			const largeArc = endAngle - startAngle > 180 ? 1 : 0;
			return [
				`M ${outerStart[0].toFixed(3)} ${outerStart[1].toFixed(3)}`,
				`A 46 46 0 ${largeArc} 1 ${outerEnd[0].toFixed(3)} ${outerEnd[1].toFixed(3)}`,
				`L ${innerEnd[0].toFixed(3)} ${innerEnd[1].toFixed(3)}`,
				`A 25 25 0 ${largeArc} 0 ${innerStart[0].toFixed(3)} ${innerStart[1].toFixed(3)}`,
				"Z",
			].join(" ");
		};

		const setBreakdownActive = (container, index) => {
			const svg = container.querySelector("[data-snapshot-donut-svg]");
			const overlay = svg?.querySelector("[data-snapshot-active-overlay]");
			const activeKey = index === null ? "" : String(index);
			const previousTimer = snapshotOverlayTimers.get(container);
			if (previousTimer) clearTimeout(previousTimer);
			container.dataset.snapshotActiveIndex = activeKey;
			const activeSegment = index === null
				? null
				: [...container.querySelectorAll("[data-snapshot-segment-index]")]
					.find((segment) => Number(segment.dataset.snapshotSegmentIndex) === index);
			container.querySelectorAll("[data-snapshot-segment-index]").forEach((segment) => {
				segment.dataset.active = "false";
			});
			container.querySelectorAll("[data-snapshot-legend-index]").forEach((item) => {
				item.dataset.active = activeKey && item.dataset.snapshotLegendIndex === activeKey ? "true" : "false";
			});
			if (!overlay || !activeSegment) {
				if (overlay) overlay.dataset.active = "false";
				return;
			}

			const activateOverlay = () => {
				if (container.dataset.snapshotActiveIndex !== activeKey) return;
				overlay.setAttribute("d", activeSegment.getAttribute("d") || "");
				overlay.style.fill = activeSegment.style.fill;
				container.dataset.snapshotRenderedIndex = activeKey;
				requestAnimationFrame(() => requestAnimationFrame(() => {
					if (container.dataset.snapshotActiveIndex === activeKey) overlay.dataset.active = "true";
				}));
			};

			// Fade the previous foreground slice out before changing its path. If the
			// path is changed while it is active, the new slice appears instantly.
			const previousRenderedKey = container.dataset.snapshotRenderedIndex || "";
			if (previousRenderedKey && previousRenderedKey !== activeKey) {
				overlay.dataset.active = "false";
				const timer = window.setTimeout(() => {
					snapshotOverlayTimers.delete(container);
					activateOverlay();
				}, 260);
				snapshotOverlayTimers.set(container, timer);
				return;
			}
			activateOverlay();
		};

		const formatBreakdownLabel = (value) => {
			const label = String(value || "未知").trim() || "未知";
			if (label.toLowerCase() === "ios") return "iOS";
			return label.replace(/^[a-z]/u, (letter) => letter.toUpperCase());
		};

		const normalizeBreakdown = (rows) => {
			const normalized = rows
				.map((row) => ({ label: formatBreakdownLabel(row?.x), value: Number(row?.y) || 0 }))
				.filter((row) => row.value >= 0)
				.sort((a, b) => b.value - a.value);
			const positiveRows = normalized.filter((row) => row.value > 0);
			const topRows = positiveRows.slice(0, 4);
			const otherValue = positiveRows.slice(4).reduce((sum, row) => sum + row.value, 0);
			if (otherValue > 0) topRows.push({ label: "其他", value: otherValue });
			normalized.filter((row) => row.value === 0).slice(0, Math.max(0, 4 - topRows.length)).forEach((row) => topRows.push(row));
			const total = positiveRows.reduce((sum, row) => sum + row.value, 0) || 1;
			return topRows.map((row) => ({ ...row, ratio: row.value / total }));
		};

		const renderBreakdown = (root, kind, rows) => {
			const container = root.querySelector(`[data-snapshot-breakdown="${kind}"]`);
			if (!container) return;
			if (!container.dataset.snapshotInteractionBound) {
				container.dataset.snapshotInteractionBound = "true";
				container.addEventListener("pointerleave", () => setBreakdownActive(container, null));
				container.addEventListener("focusout", (event) => {
					if (!container.contains(event.relatedTarget)) setBreakdownActive(container, null);
				});
			}
			const donut = container.querySelector("[data-snapshot-donut]");
			const svg = container.querySelector("[data-snapshot-donut-svg]");
			const legend = container.querySelector("[data-snapshot-legend]");
			if (!donut || !svg || !legend) return;
			const normalized = normalizeBreakdown(rows);
			const palette = kind === "browser"
				? ["#b89cff", "#ffd78a", "#8ddde2", "#ffb08f", "#f6a8d0"]
				: ["#8ec5ff", "#9fe4c6", "#ffd18a", "#c7b0ff", "#ffb2c0"];
			let angle = 0;
			const fragment = document.createDocumentFragment();
			const segmentFragment = document.createDocumentFragment();
			normalized.forEach((row, index) => {
				const color = palette[index % palette.length];
				const start = angle;
				angle += row.ratio * 360 || (normalized.length === 1 ? 359.999 : 0);
				if (row.ratio > 0) {
					const segment = document.createElementNS("http://www.w3.org/2000/svg", "path");
					segment.classList.add("analytics-snapshot__donut-segment");
					segment.dataset.snapshotSegmentIndex = String(index);
					segment.style.fill = color;
					segment.setAttribute("d", describeDonutSlice(start, angle));
					segment.addEventListener("pointerenter", () => setBreakdownActive(container, index));
					segment.addEventListener("pointerleave", () => setBreakdownActive(container, null));
					segmentFragment.append(segment);
				}

				const item = document.createElement("button");
				item.type = "button";
				item.className = "analytics-snapshot__legend-item";
				item.dataset.snapshotLegendIndex = String(index);
				item.dataset.snapshotTargetPercent = String(Math.round(row.ratio * 100));
				item.setAttribute("aria-label", `${row.label} ${Math.round(row.ratio * 100)}%`);
				const dot = document.createElement("i");
				dot.style.backgroundColor = color;
				const label = document.createElement("span");
				label.textContent = row.label;
				label.title = row.label;
				const value = document.createElement("strong");
				value.textContent = "0%";
				item.append(dot, label, value);
				item.addEventListener("pointerenter", () => setBreakdownActive(container, index));
				item.addEventListener("pointerleave", () => setBreakdownActive(container, null));
				item.addEventListener("focus", () => setBreakdownActive(container, index));
				item.addEventListener("blur", () => setBreakdownActive(container, null));
				fragment.append(item);
			});

			donut.classList.toggle("is-empty", normalized.length === 0 || !normalized.some((row) => row.ratio > 0));
			svg.style.setProperty("--snapshot-donut-progress", "0deg");
			const previousOverlayTimer = snapshotOverlayTimers.get(container);
			if (previousOverlayTimer) clearTimeout(previousOverlayTimer);
			snapshotOverlayTimers.delete(container);
			delete container.dataset.snapshotActiveIndex;
			delete container.dataset.snapshotRenderedIndex;
			svg.replaceChildren(segmentFragment);
			const activeOverlay = document.createElementNS("http://www.w3.org/2000/svg", "path");
			activeOverlay.classList.add("analytics-snapshot__donut-segment", "analytics-snapshot__donut-active-overlay");
			activeOverlay.dataset.snapshotActiveOverlay = "true";
			activeOverlay.dataset.active = "false";
			activeOverlay.setAttribute("aria-hidden", "true");
			activeOverlay.style.pointerEvents = "none";
			svg.append(activeOverlay);
			legend.replaceChildren(fragment);
		};

		// v2.x 的 stats 返回 { value, prev } 对象，部分版本返回纯数字——统一解包
		const statNumber = (value) =>
			Math.max(
				0,
				typeof value === "object" && value !== null
					? Number(value.value) || 0
					: Number(value) || 0,
			);

		const renderChange = (root, name, current, previous) => {
			const element = root.querySelector(`[data-snapshot-change="${name}"]`);
			if (!element) return;
			delete element.dataset.snapshotChangeTarget;
			delete element.dataset.snapshotChangeSign;
			if (previous <= 0) {
				element.textContent = current > 0 ? "本周期新增" : "暂无数据";
				return;
			}
			const change = Math.round(((current - previous) / previous) * 100);
			element.dataset.snapshotChangeTarget = String(Math.abs(change));
			element.dataset.snapshotChangeSign = change >= 0 ? "↑" : "↓";
			element.textContent = `${change >= 0 ? "↑" : "↓"} 0% 较上周期`;
			element.dataset.direction = change >= 0 ? "up" : "down";
		};

		const renderSnapshot = (root, payload) => {
			const { currentStats, previousStats, pageviews, devices, browsers } = payload;
			const currentPageviews = statNumber(currentStats?.pageviews);
			const currentVisitors = statNumber(currentStats?.visitors);
			const dailyRows = readRows(pageviews?.pageviews).map((row) => Number(row?.y) || 0);
			const activeDays = dailyRows.filter((value) => value > 0).length;
			const peak = Math.max(0, ...dailyRows);

			renderChange(root, "pageviews", currentPageviews, statNumber(previousStats?.pageviews));
			renderChange(root, "visitors", currentVisitors, statNumber(previousStats?.visitors));
			renderBreakdown(root, "device", readRows(devices));
			renderBreakdown(root, "browser", readRows(browsers));
			queueSnapshotAnimation(root, { pageviews: currentPageviews, visitors: currentVisitors, activeDays, peak });
			const localPreview = isLocalPreview();
			showStatus(root, localPreview ? "local" : "online", localPreview ? "本地预览 · 已更新" : "刚刚更新");
		};

		const renderPeriodSummary = (root, payload) => {
			const { currentStats, previousStats, pageviews } = payload;
			const currentPageviews = statNumber(currentStats?.pageviews);
			const currentVisitors = statNumber(currentStats?.visitors);
			const dailyRows = readRows(pageviews?.pageviews).map((row) => Number(row?.y) || 0);
			const activeDays = dailyRows.filter((value) => value > 0).length;
			const peak = Math.max(0, ...dailyRows);

			renderChange(root, "pageviews", currentPageviews, statNumber(previousStats?.pageviews));
			renderChange(root, "visitors", currentVisitors, statNumber(previousStats?.visitors));
			queueSnapshotAnimation(root, { pageviews: currentPageviews, visitors: currentVisitors, activeDays, peak });
			const localPreview = isLocalPreview();
			showStatus(root, localPreview ? "local" : "online", localPreview ? "本地预览 · 已更新" : "刚刚更新");
		};

		const markUnavailable = (root) => {
			setText(root, '[data-snapshot-stat="pageviews"], [data-snapshot-stat="visitors"], [data-snapshot-stat="activeDays"], [data-snapshot-stat="peak"]', "暂不可用");
			setText(root, "[data-snapshot-change]", "稍后重试");
			showMessage(root, "访问分布暂时不可用");
			showStatus(root, "offline", "暂不可用");
		};

		const markPeriodUnavailable = (root) => {
			setText(root, '[data-snapshot-stat="pageviews"], [data-snapshot-stat="visitors"], [data-snapshot-stat="activeDays"], [data-snapshot-stat="peak"]', "暂不可用");
			setText(root, "[data-snapshot-change]", "稍后重试");
			showStatus(root, "offline", "暂不可用");
		};

		const load = async () => {
			if (runtime.inFlight || (!getRoots().length && !getPeriodRoots().length)) return;
			const roots = getRoots();
			const periodRoots = getPeriodRoots();
			if (!apiBase || !shareId || roots.every((root) => root.dataset.ready !== "true")) {
				roots.forEach((root) => markUnavailable(root));
				periodRoots.forEach((root) => markPeriodUnavailable(root));
				return;
			}
			runtime.inFlight = true;
			roots.forEach((root) => showStatus(root, "loading", "读取中"));
			periodRoots.forEach((root) => showStatus(root, "loading", "读取中"));
			try {
				const share = await fetchShare();
				const endAt = Date.now();
				const startAt = endAt - rangeDays * dayMs;
				const previousEndAt = startAt;
				const previousStartAt = previousEndAt - rangeDays * dayMs;
				const headers = {
					"x-umami-share-token": share.token,
					"x-umami-share-context": "1",
				};
				const buildUrl = (path, start, end, params = {}) => {
					const url = new URL(`${apiBase}/api/websites/${share.websiteId}/${path}`);
					url.searchParams.set("startAt", String(start));
					url.searchParams.set("endAt", String(end));
					Object.entries(params).forEach(([key, value]) => url.searchParams.set(key, String(value)));
					return url;
				};
				const cacheKey = `rainzt:umami:analytics-snapshot:${share.websiteId}:30`;
				const cached = readCache(cacheKey, 2 * 60 * 1000);
				const payload = cached || await Promise.all([
					fetchJson(buildUrl("stats", startAt, endAt), { headers }),
					fetchJson(buildUrl("stats", previousStartAt, previousEndAt), { headers }),
					fetchJson(buildUrl("pageviews", startAt, endAt, { unit: "day", timezone: "Asia/Shanghai" }), { headers }),
					fetchJson(buildUrl("metrics", startAt, endAt, { type: "device", limit: 10 }), { headers }),
					fetchJson(buildUrl("metrics", startAt, endAt, { type: "browser", limit: 10 }), { headers }),
				]).then(([currentStats, previousStats, pageviews, devices, browsers]) => ({ currentStats, previousStats, pageviews, devices, browsers }));
				if (!cached) writeCache(cacheKey, payload);
				roots.forEach((root) => renderSnapshot(root, payload));
				periodRoots.forEach((root) => renderPeriodSummary(root, payload));
			} catch {
				roots.forEach((root) => markUnavailable(root));
				periodRoots.forEach((root) => markPeriodUnavailable(root));
			} finally {
				runtime.inFlight = false;
			}
		};

		if (!runtime.initialized) {
			runtime.initialized = true;
			document.addEventListener("astro:page-load", load);
			document.addEventListener("swup:contentReplaced", load);
		}
		load();
	})();
</script>

</MainGridLayout>

