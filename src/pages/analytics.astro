			const items = comments.map(({ nick, text, insertedAt, page }, index) => {
				const item = document.createElement("li");
				item.className = `analytics-comment${index === 0 ? " analytics-comment--latest" : ""}`;
				item.style.setProperty("--comment-index", String(index));
