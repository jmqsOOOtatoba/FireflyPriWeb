		const setupPushSnake = (panel) => {
			const grid = panel.querySelector("[data-push-heatmap-grid]");
			if (!grid) return { refresh: () => {}, destroy: () => {} };

			const rows = 7;
			const maxFood = 10;
			const initialLength = 3;
			const baseMoveInterval = 820;
			let cells = [];
			let emptyCells = new Set();
			let snake = [];
			let food = new Set();
			let targetFood = null;
			let speedMultiplier = 1;
			let foodGrowthMultiplier = 1;
			let timer = 0;
			let resetTimer = 0;
			let round = 0;
			let started = false;

			const randomItem = (items) => items[Math.floor(Math.random() * items.length)];
			const clearVisuals = () => {
				cells.forEach((cell) => {
					cell.classList.remove("is-push-snake", "is-push-snake-head", "is-push-snake-food", "is-push-snake-food-target");
					cell.style.removeProperty("--push-snake-fade");
