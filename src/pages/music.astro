---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="音乐播放器">
  <!-- 背景黑色层 -->
  <div class="music-bg"></div>
  
  <!-- 初始状态：CD -->
  <div id="cd-initial" class="cd-initial">
    <div class="cd-disc" id="cd-disc">
      <div class="cd-inner">
        <div class="cd-cover" id="cd-cover"></div>
      </div>
    </div>
  </div>

  <!-- 展开状态：播放器 -->
  <div id="player-expanded" class="player-expanded hidden">
    <!-- 底层：大封面背景 -->
    <div class="cover-bg" id="cover-bg"></div>
    <!-- 暗角效果覆盖层 -->
    <div class="vignette-overlay"></div>
    
    <!-- 左侧：音乐播放器（使用主页组件样式） -->
    <div class="vinyl-section">
      <div class="music-player-widget w-full max-w-sm mx-auto relative">
        <!-- Top Row: Cover & Info -->
        <div class="flex items-center gap-3 mb-3 px-1">
          <!-- Circular Cover -->
          <div class="relative shrink-0 w-16 h-16 group">
            <div class="w-full h-full rounded-full overflow-hidden shadow-lg border-2 border-white dark:border-neutral-700 relative z-10 bg-(--primary)/10 flex items-center justify-center">
              <Icon is:inline name="material-symbols:music-note-rounded" class="text-2xl text-(--primary) opacity-40 absolute" aria-hidden="true" />
              <img id="music-cover" class="music-cover w-full h-full object-cover animate-spin-slow relative z-10 opacity-0 transition-opacity duration-300" src="" alt="封面" style="animation-play-state: paused;" />
            </div>
          </div>

          <!-- Info Section -->
          <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
            <div class="flex items-center justify-between overflow-hidden gap-2">
              <div class="flex-1 min-w-0 overflow-hidden relative">
                <h3 id="song-name" class="music-title font-bold text-base text-neutral-800 dark:text-neutral-100 leading-tight truncate">
                  未知歌曲
                </h3>
              </div>
              <!-- Top Right: Lyric Toggle -->
              <button id="lrc-toggle" class="btn-lrc-toggle hover:text-(--primary) transition-all duration-300 p-0.5 pr-2 transform active:scale-95 text-neutral-400 shrink-0" title="歌词">
                <Icon is:inline name="material-symbols:subtitles-off-outline-rounded" id="icon-lrc-off" class="icon-lrc-off text-xl" aria-hidden="true" />
                <Icon is:inline name="material-symbols:subtitles-outline-rounded" id="icon-lrc-on" class="icon-lrc-on text-xl hidden" aria-hidden="true" />
              </button>
            </div>

            <div class="min-w-0 overflow-hidden">
              <p id="song-artist" class="music-artist text-xs font-medium text-neutral-500 dark:text-neutral-400 truncate">
                未知歌手
              </p>
            </div>

            <!-- Time Display & Volume -->
            <div class="flex items-center gap-3 text-neutral-400 h-5">
              <div class="text-[10px] font-mono flex items-center gap-1 shrink-0 h-full" aria-live="polite">
                <span id="current-time" class="current-time">0:00</span>
                <span class="opacity-50" aria-hidden="true">/</span>
                <span id="duration" class="total-time">0:00</span>
              </div>

              <!-- Volume (Always visible) -->
              <div class="flex items-center gap-1 bg-transparent h-full ml-auto">
                <button id="mute-btn" class="btn-mute hover:text-(--primary) transition-colors p-0.5 rounded-md flex items-center" title="音量">
                  <Icon is:inline name="material-symbols:volume-up-rounded" id="vol-high" class="icon-vol-high text-lg" aria-hidden="true" />
                  <Icon is:inline name="material-symbols:volume-off-rounded" id="vol-mute" class="icon-vol-mute text-lg hidden" aria-hidden="true" />
                </button>
                <div class="w-16 transition-all duration-300 ease-out flex items-center">
                  <div id="volume-bar" class="vol-container h-1 w-16 bg-neutral-300/50 dark:bg-neutral-500/40 rounded-full cursor-pointer relative ml-1">
                    <div id="volume-fill" class="vol-bar absolute left-0 top-0 h-full bg-(--primary) rounded-full w-[30%]"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Progress Bar (Slim) -->
        <div class="px-1">
          <div id="progress-bar" class="progress-container relative w-full h-2 bg-neutral-300/60 dark:bg-neutral-500/40 rounded-full cursor-pointer touch-none mb-3 group mt-3">
            <div id="progress" class="progress-bar absolute left-0 top-0 h-full bg-(--primary) rounded-full w-0 transition-[width] duration-100"></div>
            <!-- Hover Thumb -->
            <div class="progress-thumb absolute top-1/2 -mt-1.5 -ml-1.5 w-3 h-3 bg-(--primary) ring-2 ring-white dark:ring-neutral-800 rounded-full shadow-sm scale-0 group-hover:scale-100 transition-transform duration-200"></div>
          </div>
        </div>

        <!-- Controls Row -->
        <div class="flex items-center justify-between px-1 select-none">
          <!-- Repeat Mode -->
          <button id="repeat-btn" class="btn-repeat text-neutral-300 dark:text-neutral-600 hover:text-(--primary) transition-colors p-2 active:scale-95" title="播放模式">
            <Icon is:inline name="material-symbols:repeat-rounded" id="icon-repeat" class="icon-repeat text-xl" aria-hidden="true" />
            <Icon is:inline name="material-symbols:repeat-one-rounded" id="icon-repeat-one" class="icon-repeat-one text-xl hidden" aria-hidden="true" />
            <Icon is:inline name="material-symbols:shuffle-rounded" id="icon-shuffle" class="icon-shuffle text-xl hidden" aria-hidden="true" />
          </button>

          <!-- Prev -->
          <button id="prev-btn" class="btn-prev text-neutral-600 dark:text-neutral-300 hover:text-(--primary) transition-colors p-2 active:scale-95" title="上一曲">
            <Icon is:inline name="material-symbols:skip-previous-rounded" class="text-3xl" aria-hidden="true" />
          </button>

          <!-- Play/Pause (Feature) -->
          <button id="play-btn" class="btn-play w-12 h-12 bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active) text-(--primary) rounded-full flex items-center justify-center transition-all duration-300" title="播放">
            <Icon is:inline name="material-symbols:play-arrow-rounded" id="play-icon" class="icon-play text-3xl ml-0.5" aria-hidden="true" />
            <Icon is:inline name="material-symbols:pause-rounded" id="pause-icon" class="icon-pause text-3xl hidden" aria-hidden="true" />
          </button>

          <!-- Next -->
          <button id="next-btn" class="btn-next text-neutral-600 dark:text-neutral-300 hover:text-(--primary) transition-colors p-2 active:scale-95" title="下一曲">
            <Icon is:inline name="material-symbols:skip-next-rounded" class="text-3xl" aria-hidden="true" />
          </button>

          <!-- Playlist Toggle Arrow -->
          <button id="playlist-btn" class="btn-drawer-toggle text-neutral-400 hover:text-(--primary) transition-all duration-300 p-2 transform active:scale-95" title="播放列表">
            <Icon is:inline name="mdi:playlist-music" class="text-xl" aria-hidden="true" />
          </button>
        </div>

        <!-- Lyrics Drawer -->
        <div id="lrc-drawer" class="lrc-drawer grid transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] grid-rows-[0fr] opacity-0">
          <div class="overflow-hidden min-h-0">
            <div class="mt-2 pt-2 border-t border-neutral-100 dark:border-white/5 mx-1">
              <div id="lrc-container" class="lrc-container h-48 overflow-y-auto custom-scrollbar flex flex-col items-center gap-2 p-4 py-24 text-center relative scroll-smooth" role="listbox" aria-label="歌词">
                <div class="text-neutral-400 text-sm py-10" role="option">暂无歌词</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Playlist Drawer (Accordion) -->
        <div id="playlist-drawer" class="playlist-drawer grid transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] grid-rows-[0fr] opacity-0 overflow-visible">
          <div class="overflow-visible min-h-0">
            <div class="mt-2 pt-2 border-t border-neutral-100 dark:border-white/5 mx-1">
              <div id="playlist-container" class="playlist-container max-h-48 overflow-y-auto custom-scrollbar pr-1 pb-1 relative" role="listbox" aria-label="播放列表">
                <!-- Items -->
              </div>
            </div>
          </div>
        </div>

        <!-- Loading Overlay -->
        <div class="music-loading absolute inset-0 z-20 flex flex-col items-center justify-center bg-white/60 dark:bg-[#1e1e1e]/60 backdrop-blur-[2px] transition-opacity duration-300 opacity-0 pointer-events-none rounded-xl" aria-busy="true" aria-hidden="true">
          <div class="w-8 h-8 text-(--primary) animate-spin">
            <Icon is:inline name="material-symbols:sync-rounded" class="text-3xl" aria-hidden="true" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ============================================
     背景层样式
     ============================================ */
  .music-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
    z-index: 50;
  }

  /* ============================================
     初始CD样式
     ============================================ */
  .cd-initial {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 60;
    transition: opacity 0.5s ease;
  }

  .cd-disc {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a1a 0%, #333 50%, #1a1a1a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: spin 8s linear infinite;
    box-shadow: 0 0 30px rgba(0,0,0,0.5);
  }

  .cd-inner {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #444;
  }

  .cd-cover {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    background-color: #333;
  }

  /* ============================================
     展开状态播放器
     ============================================ */
  .player-expanded {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    z-index: 55;
  }

  .cover-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .vinyl-section {      
    position: relative;
    width: 60%;
    height: 100%;
    background: linear-gradient(to right, 
      rgba(255,255,255,1) 0%, 
      rgba(255,255,255,0.95) 50%, 
      rgba(255,255,255,0.7) 75%, 
      transparent 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    animation: slideInLeft 0.8s ease-out;
    padding: 2rem;
    z-index: 2;
  }

  :global(.dark) .vinyl-section {
    background: linear-gradient(to right, 
      rgba(20,20,20,1) 0%, 
      rgba(20,20,20,0.95) 50%, 
      rgba(20,20,20,0.7) 75%, 
      transparent 100%
    );
  }

  /* ============================================
     音乐播放器组件样式
     ============================================ */
  .music-player-widget {
    padding: 1.25rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    overflow: visible;
  }

  :global(.dark) .music-player-widget {
    background: rgba(30, 30, 30, 0.85);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  /* ============================================
     暗角效果
     ============================================ */
  .vignette-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* 径向渐变：中心透明，边缘黑色 */
    background: radial-gradient(
      ellipse at center,
      transparent 50%,
      rgba(0, 0, 0, 0.3) 80%,
      rgba(0, 0, 0, 0.6) 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* ============================================
     动画
     ============================================ */
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .animate-spin-slow {
    animation: spin-slow 10s linear infinite;
  }

  @keyframes slideInLeft {
    from {
      transform: translateX(-100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .paused {
    animation-play-state: paused !important;
  }

  .hidden {
    display: none !important;
  }

  /* ============================================
     播放列表展开状态
     ============================================ */
  .playlist-drawer.expanded {
    grid-template-rows: 1fr;
    opacity: 1;
  }

    /* ============================================
     歌词抽屉样式
     ============================================ */
  .lrc-drawer.expanded {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .lrc-container {
    max-height: 12rem;
    overflow-y: auto;
    padding: 1rem;
    padding-top: 6rem;
    padding-bottom: 6rem;
    text-align: center;
    position: relative;
    scroll-behavior: smooth;
  }

  .lrc-line {
    font-size: 0.875rem;
    color: #999;
    padding: 0.25rem 0;
    transition: all 0.3s ease;
  }

  .lrc-line.active {
    color: var(--primary, #3b82f6);
    font-weight: 600;
    font-size: 1rem;
  }

  :global(.dark) .lrc-line {
    color: #666;
  }

  :global(.dark) .lrc-line.active {
    color: var(--primary, #3b82f6);
  }
/* ============================================
     播放列表歌曲项
     ============================================ */
  .playlist-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease;
  }

  .playlist-item:hover {
    background-color: rgba(0, 0, 0, 0.04);
  }

  :global(.dark) .playlist-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
  }

  .playlist-item.active {
    background-color: rgba(59, 130, 246, 0.08);
  }

  :global(.dark) .playlist-item.active {
    background-color: rgba(59, 130, 246, 0.12);
  }

  .playlist-item-index {
    width: 18px;
    font-size: 0.6875rem;
    color: #999;
    text-align: center;
    flex-shrink: 0;
  }

  .playlist-item.active .playlist-item-index {
    color: var(--primary, #3b82f6);
  }

  .playlist-item-cover {
    width: 32px;
    height: 32px;
    border-radius: 0.25rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .playlist-item-info {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .playlist-item-name {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.dark) .playlist-item-name {
    color: #eee;
  }

  .playlist-item.active .playlist-item-name {
    color: var(--primary, #3b82f6);
  }

  .playlist-item-artist {
    font-size: 0.6875rem;
    color: #999;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ============================================
     移动端适配
     ============================================ */
  @media (max-width: 768px) {
    .player-expanded {
      flex-direction: column;
    }

    .vinyl-section {
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, 
        rgba(255,255,255,1) 0%, 
        rgba(255,255,255,0.95) 60%, 
        rgba(255,255,255,0.8) 100%
      );
      padding: 1rem;
    }

    :global(.dark) .vinyl-section {
      background: linear-gradient(to bottom, 
        rgba(20,20,20,1) 0%, 
        rgba(20,20,20,0.95) 60%, 
        rgba(20,20,20,0.8) 100%
      );
    }

    .music-player-widget {
      max-width: 100%;
    }

    .cd-disc {
      width: 200px;
      height: 200px;
    }

    .cd-inner {
      width: 80px;
      height: 80px;
    }

    .cd-cover {
      width: 65px;
      height: 65px;
    }
  }
</style>

<script>
  /* ============================================
     API配置
     ============================================ */
  const apiConfig = {
    server: "netease",
    type: "artist",
    id: "47028814",
    api: "https://api.i-meto.com/meting/api?server=:server&type=:type&id=:id&r=:r"
  };

  // 自定义右侧大背景图（改成你想要的图片URL）
  const customBgImage = "https://tu.mstzuomu.space/file/莲宵映月/1786940751941_20240220_093125.jpg";

  /* ============================================
     全局变量
     ============================================ */
  let playlist = [];
  let currentIndex = 0;
  let currentSong = null;
  let audio = new Audio();
  let isPlaying = false;
  let isMuted = false;
  let playMode = 'list';

  /* ============================================
     更新播放列表面板
     ============================================ */
  function updatePlaylistPanel() {
    const container = document.getElementById('playlist-container');
    if (!container) return;
    
    container.innerHTML = playlist.map((song, index) => `
      <div class="playlist-item ${index === currentIndex ? 'active' : ''}" data-index="${index}">
        <span class="playlist-item-index">${index === currentIndex ? '▶' : index + 1}</span>
        <img class="playlist-item-cover" src="${song.cover}" alt="${song.name}" onerror="this.style.display='none'" />
        <div class="playlist-item-info">
          <div class="playlist-item-name">${song.name}</div>
          <div class="playlist-item-artist">${song.artist}</div>
        </div>
      </div>
    `).join('');
    
    container.querySelectorAll('.playlist-item').forEach(item => {
      item.addEventListener('click', () => {
        const index = parseInt(item.dataset.index);
        loadSong(index);
        play();
        updatePlaylistPanel();
      });
    });
  }

  /* ============================================
     获取歌单数据
     ============================================ */
  async function fetchPlaylist() {
    const url = apiConfig.api
      .replace(':server', apiConfig.server)
      .replace(':type', apiConfig.type)
      .replace(':id', apiConfig.id);
    
    try {
      const response = await fetch(url);
      const data = await response.json();
      
      playlist = data.map(item => ({
        name: item.title,
        artist: item.author,
        url: item.url,
        cover: item.pic,
      }));
      
      if (playlist.length > 0) {
        loadSong(0);
        updatePlaylistPanel();
      }
    } catch (error) {
      console.error('获取歌单失败:', error);
    }
  }

  /* ============================================
     加载歌曲
     ============================================ */
  function loadSong(index) {
    if (index < 0 || index >= playlist.length) return;
    
    currentIndex = index;
    currentSong = playlist[index];
    
    const cdCover = document.getElementById('cd-cover');
    const musicCover = document.getElementById('music-cover');
    const coverBg = document.getElementById('cover-bg');
    const songName = document.getElementById('song-name');
    const songArtist = document.getElementById('song-artist');
    
    if (cdCover) cdCover.style.backgroundImage = `url(${currentSong.cover})`;
    if (musicCover) {
      musicCover.src = currentSong.cover;
      musicCover.classList.add('opacity-100');
      musicCover.classList.remove('opacity-0');
    }
    if (coverBg) coverBg.style.backgroundImage = `url(${customBgImage})`;
    if (songName) songName.textContent = currentSong.name;
    if (songArtist) songArtist.textContent = currentSong.artist;
    
    audio.src = currentSong.url;
    audio.load();
  }

  /* ============================================
     初始化
     ============================================ */
  function init() {
    const cdInitial = document.getElementById('cd-initial');
    const playerExpanded = document.getElementById('player-expanded');
    const musicCover = document.getElementById('music-cover');
    const playBtn = document.getElementById('play-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const progressBar = document.getElementById('progress-bar');
    const progress = document.getElementById('progress');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const muteBtn = document.getElementById('mute-btn');
    const volHigh = document.getElementById('vol-high');
    const volMute = document.getElementById('vol-mute');
    const volumeBar = document.getElementById('volume-bar');
    const volumeFill = document.getElementById('volume-fill');
    const playlistBtn = document.getElementById('playlist-btn');
    const playlistDrawer = document.getElementById('playlist-drawer');
    const repeatBtn = document.getElementById('repeat-btn');
    const iconRepeat = document.getElementById('icon-repeat');
    const iconRepeatOne = document.getElementById('icon-repeat-one');
    const iconShuffle = document.getElementById('icon-shuffle');

    if (!cdInitial || !playerExpanded) return;

    fetchPlaylist();

    // 音量初始化
    audio.volume = 0.3;

    // 点击CD展开
    cdInitial.addEventListener('click', () => {
      cdInitial.classList.add('hidden');
      playerExpanded.classList.remove('hidden');
    });

    // 播放/暂停
    if (playBtn) {
      playBtn.addEventListener('click', () => {
        if (isPlaying) pause();
        else play();
      });
    }

    // 上一曲
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        let newIndex = currentIndex - 1;
        if (newIndex < 0) newIndex = playlist.length - 1;
        loadSong(newIndex);
        if (isPlaying) play();
        updatePlaylistPanel();
      });
    }

    // 下一曲
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        let newIndex = currentIndex + 1;
        if (newIndex >= playlist.length) newIndex = 0;
        loadSong(newIndex);
        if (isPlaying) play();
        updatePlaylistPanel();
      });
    }

    // 进度条点击
    if (progressBar) {
      progressBar.addEventListener('click', (e) => {
        const rect = progressBar.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        if (audio.duration) {
          audio.currentTime = percent * audio.duration;
        }
      });
    }

    // 音量控制
    if (volumeBar) {
      volumeBar.addEventListener('click', (e) => {
        const rect = volumeBar.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        audio.volume = Math.max(0, Math.min(1, percent));
        if (volumeFill) volumeFill.style.width = `${audio.volume * 100}%`;
      });
    }

    // 静音按钮
    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        isMuted = !isMuted;
        audio.muted = isMuted;
        if (volHigh && volMute) {
          if (isMuted) {
            volHigh.classList.add('hidden');
            volMute.classList.remove('hidden');
          } else {
            volHigh.classList.remove('hidden');
            volMute.classList.add('hidden');
          }
        }
      });
    }

    // 播放列表按钮
    if (playlistBtn && playlistDrawer) {
      playlistBtn.addEventListener('click', () => {
        playlistDrawer.classList.toggle('expanded');
        if (playlistDrawer.classList.contains('expanded')) {
          updatePlaylistPanel();
        }
      });
    }

    // 循环模式按钮
    if (repeatBtn) {
      repeatBtn.addEventListener('click', () => {
        if (playMode === 'list') {
          playMode = 'one';
          iconRepeat.classList.add('hidden');
          iconRepeatOne.classList.remove('hidden');
          iconShuffle.classList.add('hidden');
        } else if (playMode === 'one') {
          playMode = 'shuffle';
          iconRepeat.classList.add('hidden');
          iconRepeatOne.classList.add('hidden');
          iconShuffle.classList.remove('hidden');
        } else {
          playMode = 'list';
          iconRepeat.classList.remove('hidden');
          iconRepeatOne.classList.add('hidden');
          iconShuffle.classList.add('hidden');
        }
      });
    }

    // 音频事件
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        const percent = (audio.currentTime / audio.duration) * 100;
        if (progress) progress.style.width = `${percent}%`;
        if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      if (durationEl) durationEl.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('ended', () => {
      let newIndex;
      if (playMode === 'one') {
        newIndex = currentIndex;
      } else if (playMode === 'shuffle') {
        newIndex = Math.floor(Math.random() * playlist.length);
      } else {
        newIndex = currentIndex + 1;
        if (newIndex >= playlist.length) newIndex = 0;
      }
      loadSong(newIndex);
      play();
      updatePlaylistPanel();
    });
  }

  /* ============================================
     播放/暂停
     ============================================ */
  function play() {
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const musicCover = document.getElementById('music-cover');
    
    audio.play();
    isPlaying = true;
    
    if (playIcon) playIcon.classList.add('hidden');
    if (pauseIcon) pauseIcon.classList.remove('hidden');
    if (musicCover) musicCover.style.animationPlayState = 'running';
  }

  function pause() {
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const musicCover = document.getElementById('music-cover');
    
    audio.pause();
    isPlaying = false;
    
    if (playIcon) playIcon.classList.remove('hidden');
    if (pauseIcon) pauseIcon.classList.add('hidden');
    if (musicCover) musicCover.style.animationPlayState = 'paused';
  }

  /* ============================================
     工具函数
     ============================================ */
  function formatTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  /* ============================================
     页面加载初始化
     ============================================ */
  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('swup:contentReplaced', init);
</script>







